# Shared setup: two instances in one session. Included by the other scenarios.
# Profiles LocalLow/Just2D/Drova/Sprint_24_A and _B (copies of Sprint_24). Override the save with -D hero=N -D slotA=N -D slotB=N.

default hero 5
default slotA 0
default slotB 0

# Link delay for both, in ms (-D net=100-200 for real latency); none by default.
default net 0-0
launch A --net-delay $net
launch B --net-delay $net
A wait ready=1 timeout=240
B wait ready=1 timeout=240

# Never load anything into an instance that would write the player's real savegames.
A wait saves=separate timeout=1
B wait saves=separate timeout=1

A load $hero $slotA
B load $hero $slotB
A wait world=1 timeout=240
B wait world=1 timeout=240

# The host's loot rule travels with the session: -D loot=shared, or a scenario's own default.
default loot instanced
A lootmode $loot
# Creature health in percent (a saved preference: set every run so no scenario leaks it).
default enemyhealth 100
A enemyhealth $enemyhealth
A host
A wait code=* timeout=60
B join $A.code
A wait players=2 timeout=60
B wait players=2 timeout=60
