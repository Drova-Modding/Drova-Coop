# The game's arena together, lost: both go down. The fight ends lost (no win flag), never a lost run (arena knockout is a brawl).
# Needs hero 0 slot 65 in every profile (fixture_redtower_rl.scn).

default hero 0
default slotA 65
default slotB 65
include session.coop
set morvin 5b7d1640-817f-451a-adf9-d074e46a6a1d
set ebru d0f8d7a1-aa3e-4178-8ab8-54526c631d77
track $ebru

A run invincibility
B run invincibility
A run DayTime 10
B expect time contains "hour=10." timeout=15
B tp -1330,560

set p A
set canfight CanFightEbru
set accept AcceptEbruFight
set face MainFight_FaceEbru
include arena_main_book.part
# The outcome flag is MainFight_Participant_01_Won, written at the fight's end: reset it to the opposite now.
# WonEbru proves nothing: the game sets it when the fight starts.
A setgvar DAS_ArenaSystem MainFight_Participant_01_Won 0

# The client's strike puts its body into the host's fight, on the player's side.
B tpnear $ebru 40 0
sleep 5
B hit $ebru 2500
A expect counter arenajoined >= 1 timeout=10

# The host goes down; the fight goes on while the teammate stands.
A run invincibility
A hit me 5000
A expect ai me contains mode=KnockOut timeout=10
sleep 5
A expect ai $ebru contains brawl=1 timeout=1
A expect gvar DAS_ArenaSystem MainFight_Participant_01_Won == 0 timeout=1
# The client goes down too: the fight is over, she won.
B run invincibility
B hit me 5000
A expect counter arenako >= 1 timeout=15
A expect ai $ebru contains brawl=0 timeout=30
A expect ai me contains brawl=0 timeout=30
sleep 3
A expect gvar DAS_ArenaSystem MainFight_Participant_01_Won == 1 timeout=5
A expect counter gameovers <= 0 timeout=1
B expect counter gameovers <= 0 timeout=1
A expect ai me contains dead=0 timeout=20
B expect ai me contains dead=0 timeout=20
