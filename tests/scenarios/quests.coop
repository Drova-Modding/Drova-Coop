# Quest-state rules that need no special save: catch-up for a late joiner, and a finished quest never reopened.

launch A
launch B
A wait ready=1 timeout=240
B wait ready=1 timeout=240
A wait saves=separate timeout=1
B wait saves=separate timeout=1

default hero 5
default slotA 0
default slotB 0
A load $hero $slotA
B load $hero $slotB
A wait world=1 timeout=300
B wait world=1 timeout=300

# Catch-up: the host moves a flag before the client joins; the client's copy says otherwise.
A setgvar QuestVars_FeedingTheSheep HTT_Evi 1
B setgvar QuestVars_FeedingTheSheep HTT_Evi 0

A host
A wait code=* timeout=60
B join $A.code
A wait players=2 timeout=60
B expect gvar QuestVars_FeedingTheSheep HTT_Evi == 1 timeout=30

# A finished quest is never reopened by a teammate who is behind (QuestState 3 = completed, 2 = running).
A setgvar QuestVars_FeedingTheSheep QuestState 3
B expect gvar QuestVars_FeedingTheSheep QuestState == 3 timeout=15
B setgvar QuestVars_FeedingTheSheep QuestState 2
sleep 5
A expect gvar QuestVars_FeedingTheSheep QuestState == 3 timeout=1
A expect counter regressions >= 1 timeout=5
A run coop_status
