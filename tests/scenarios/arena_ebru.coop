# The game's arena, Ebru fought by the host with the client helping: the client sees the host's traps, summons and
# shut gates (none from its own copy); the client's blows count; the win is shared.
# Needs hero 0 slot 65 in every profile (fixture_redtower_rl.scn).

default hero 0
default slotA 65
default slotB 65
include session.coop
set morvin 5b7d1640-817f-451a-adf9-d074e46a6a1d
set ebru d0f8d7a1-aa3e-4178-8ab8-54526c631d77
track $ebru

A run invincibility
B run invincibility
A run DayTime 10
B expect time contains "hour=10." timeout=15
B tp -1330,560

set p A
set canfight CanFightEbru
set accept AcceptEbruFight
set face MainFight_FaceEbru
include arena_main_book.part
# The outcome flag is MainFight_Participant_01_Won, written at the fight's end: reset it to the opposite now.
# WonEbru proves nothing: the game sets it when the fight starts.
A setgvar DAS_ArenaSystem MainFight_Participant_01_Won 1

# The gate shut on the client too.
B expect counter gatesapplied >= 1 timeout=20
B expect objects ActiveFight_Blocker list contains "=1" timeout=5

B tpnear $ebru 40 0
sleep 20
A expect counter traplaid >= 1 timeout=60
B expect counter trapshown >= 1 timeout=10
B counter trapwithdrawn
A objects Trap_NPC_Ebru
B objects Trap_NPC_Ebru

# Hurt, she summons: the host's, shared; the client's copy conjures none.
B hit $ebru 2500
sleep 2
B hit $ebru 1500
A expect counter spawnshared >= 1 timeout=60
B expect counter spawnskipped >= 1 timeout=30
A actors 900
B actors 900

B ?hit $ebru 3000
sleep 2
A ?hit $ebru 3000
sleep 2
B ?hit $ebru 3000
A expect ai $ebru contains brawl=0 timeout=60
A expect gvar DAS_ArenaSystem MainFight_Participant_01_Won == 0 timeout=5
A expect ai me contains brawl=0 timeout=30
