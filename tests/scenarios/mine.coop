# The bandit mine ("Missing", QuestVars_BanditMineBrutus), played through by two players.
# Needs hero 2 slot 2 (mine untouched: BanditMineBrutus_V2.EnterFromOutSide=0, Hasso alive).
# Hero 5 slot 0 is NOT one: it raided the mine from outside (faces hidden, Hasso dead).
# Traps:
# - An NPC's intent fires only once the player MOVES near him: tpnear, then a one-second walk.
# - Any mine NPC's hub/gate dialogue can be forced with "talk <guid> <tree>".
# - A face takes three uses per charge and refuses the next charge while its pile still lies there.
# - The mine's days are gvars only (DailyRoutines.DayN); the clock does not move.

include mine_entry.part
include mine_boss.part

# ---- Day 1: mining crossed over; a pile must be takeable by whoever did not mine it. ----
set miner A
set hauler B
set face Horizontal_First
set tally BanditMineBrutus_Day01 OpenRubbleAmount
include mine_charge.part
include mine_charge.part
include mine_charge.part
B expect gvar BanditMineBrutus_Day01 DestroyFirstStone == 1 timeout=10

set miner B
set hauler A
set face Horizontal_Second
include mine_charge.part
include mine_charge.part
include mine_charge.part
A expect gvar BanditMineBrutus_Day01 DestroySecondStoneStack == 3 timeout=10
A expect counter workapplied >= 3 timeout=5
B expect counter workapplied >= 3 timeout=5

# Lanzo ends the shift (his intent fires where he stands; whoever gets it plays it).
B expect gvar BanditMineBrutus_Day01 DestroySecondStone == 1 timeout=10
B skip
A skip
B expect gvar BanditMineBrutus_Day01 FinishedWork == 1 timeout=60
A expect gvar BanditMineBrutus_Day01 FinishedTaskForDay == 1 timeout=20
B expect gvar BanditMineBrutus_Day01 FinishedTaskForDay == 1 timeout=20
sleep 3
A bye
B bye

# ---- Night 1: the client sleeps in the mine bed; the host's world moves to day 2 without sleeping. ----
B tp 22686,60146
B use Interact_Bed 20
B expect dialogue contains "in=1" timeout=15
B skip
A expect gvar BanditMineBrutus_DailyRoutines Day2 == 1 timeout=20
# The morning cutscene walks an NPC whose feet the other machine writes; the mod's scene-move rescue frees it.
B expect dialogue contains "in=0" timeout=120
# The host's own bed: its unsaved day cursor (advanced only by the sleeper) moves to day 2; day 2 work is not done.
A tp 22686,60146
A use Interact_Bed 20
A expect counter bedmoved >= 1 timeout=5
A expect dialogue contains "I've_got_work_to_do" timeout=10
A skip
A expect dialogue contains "in=0" timeout=15

# ---- Day 2: breakfast and Mali by the host, the third face and the secret room by the client. ----
A tpnear $bruna 60 0
A talk $bruna
A skip
A expect dialogue contains "got to go" timeout=20
A choose got to go
A skip
B expect gvar BanditMineBrutus_Day02 GotEating == 1 timeout=10
A expect dialogue contains "in=0" timeout=10
# Hasso's walk to work tells Mali to send the prisoners in.
A expect gvar EVars_Mali_Intent Day02_GuardDialog == 1 timeout=90
A tpnear $mali 60 0
A walk -1 0 1
A expect dialogue contains "in=1" timeout=15
A skip
B expect gvar BanditMineBrutus_Day02 Working == 1 timeout=30

set miner B
set hauler B
set face Horizontal_Third
# This face drops piles but counts none, and the cart still subtracts per load (vanilla goes negative). The count
# only gates day 1, so EnterFromOutSide stands in as a value that stays 0.
set tally BanditMineBrutus_V2 EnterFromOutSide
include mine_charge.part
include mine_charge.part
include mine_charge.part
A expect gvar BanditMineBrutus_Day02 DestroyThirdStone == 1 timeout=10

B tp 23393,60792
B walk 0 1 1
A expect gvar BanditMineBrutus_Day02 FoundSecretRoom == 1 timeout=10

# Hasso's evening talk by the host. His intent fires only once he stands at his evening spot: a second approach catches him.
A tpnear $hasso 60 0
A walk -1 0 1
sleep 6
A tpnear $hasso 60 0
A walk -1 0 1
A expect dialogue contains "in=1" timeout=15
A skip
A expect dialogue contains "choices=0:Nope, zilch." timeout=20
A choose zilch
A skip
A expect dialogue contains "in=0" timeout=90
B expect gvar BanditMineBrutus_Day02 FinishedTaskToday == 1 timeout=10

# ---- Night 2: the host sleeps. ----
A tp 22686,60146
A use Interact_Bed 20
A expect dialogue contains "in=1" timeout=15
A skip
A expect dialogue contains "Whaddya" timeout=30
A choose Whaddya
A skip
A expect dialogue contains "get out of here somehow" timeout=20
A choose get out of here somehow
A skip
A expect dialogue contains "in=0" timeout=90
B expect gvar BanditMineBrutus_DailyRoutines Day3 == 1 timeout=10
B expect gvar BanditMineBrutus_Day03 WokeUp == 1 timeout=10

# ---- Day 3, the food: Bruna by the host, Kolina and the mushroom cave by the client. ----
A tpnear $bruna 60 0
A walk -1 0 1
A expect dialogue contains "in=1" timeout=15
A skip
A expect dialogue contains "I'll manage" timeout=30
A choose manage
A skip
A expect dialogue contains "supposed to get for you" timeout=20
A choose supposed to get for you
A skip
A expect dialogue contains "in=0" timeout=90
B expect gvar BanditMineBrutus_Day03 HTT_BrunaAboutEating == 1 timeout=10

B tpnear $kolina 60 0
B expect near $kolina 400 contains loaded timeout=15
B talk $kolina
B skip
B expect dialogue contains "Lanzo sent me" timeout=20
B choose Lanzo sent me
B skip
B expect dialogue contains "in=0" timeout=90
A expect gvar BanditMineBrutus_Day03 HTT_Kolina_EnterCave == 1 timeout=10
B expect items tool_torch >= 2 timeout=5

# Mushrooms split three and three: pickups are per world (each keeps ten), and Kolina counts only the mushrooms
# of the player in front of her.
B tp 22328,58121
B use PickUp_Cons_Mushroom 60
sleep 2.5
B tp 22321,58091
B use PickUp_Cons_Mushroom 60
sleep 2.5
B tp 22150,58512
B use PickUp_Cons_Mushroom 60
sleep 2.5
A tp 22818,58199
A use PickUp_Cons_Mushroom 60
sleep 2.5
A tp 22132,58521
A use PickUp_Cons_Mushroom 60
sleep 2.5
A tp 22498,58832
A use PickUp_Cons_Mushroom 60
sleep 2.5
A expect items item_mushroom == 3 timeout=5
B expect items item_mushroom == 3 timeout=5

# Walking back through the cave mouth arms Kolina's gate, for both.
B tp 22841,59300
B walk 0 -1 1.5
A expect gvar BanditMineBrutus_Day03 KolinaGateIsActive == 1 timeout=10

# With three, Kolina only says "not enough" and sends the client back. Her gate volume sits north of her (y~59450).
B tp 22775,59455
B walk 0 1 0.3
B expect dialogue contains "Show_me!" timeout=15
B skip
B expect dialogue contains "choices=0:I still haven't got enough." timeout=15
B choose haven't got enough
B skip
B expect dialogue contains "in=0" timeout=90
B expect inside Gate_BrutusMine_Kolina contains "overlap=0" timeout=10
A expect gvar BanditMineBrutus_Day03 HTT_KolinaHasEnoughFood == 0 timeout=1

# Three more from the client's own world (the host's picks are still there for the client).
B tp 22818,58199
B use PickUp_Cons_Mushroom 60
sleep 2.5
B tp 22132,58521
B use PickUp_Cons_Mushroom 60
sleep 2.5
B tp 22498,58832
B use PickUp_Cons_Mushroom 60
sleep 2.5
B expect items item_mushroom == 6 timeout=5

# Dig-pigs: one killed by each, dead for both, also after both walk away and back.
B tpnear $pig 120 0
B expect near $pig 400 contains loaded timeout=10
B hit $pig 200
B hit $pig 200
B hit $pig 200
B expect dead $pig contains 1 timeout=5
A expect dead $pig contains 1 timeout=15
A tpnear $pig2 120 0
A expect near $pig2 400 contains loaded timeout=10
A hit $pig2 200
A hit $pig2 200
A hit $pig2 200
A expect dead $pig2 contains 1 timeout=5
B expect dead $pig2 contains 1 timeout=15
A tp 22686,60146
B tp 22686,60146
sleep 5
B tpnear $pig 150 0
A tpnear $pig2 150 0
B expect dead $pig contains 1 timeout=10
A expect dead $pig2 contains 1 timeout=10
B expect dead $pig2 contains 1 timeout=10
A expect dead $pig contains 1 timeout=10

# Back through the gate with six. Her volume does not restart the scene right after a push back, so start it directly,
# from just inside the cave: standing in the volume starts the same scene too and the two starts collide.
B tp 22742,59330
B expect near $kolina 400 contains loaded timeout=15
sleep 2
B bye
B talk $kolina DT_Gate_BrutusMine_Kolina
B skip
B expect dialogue contains "Here. (show)" timeout=20
B choose Here. (show)
B skip
# Still in her volume, the client gets her second line at once: "You've got no business here."
sleep 4
B skip
B expect dialogue contains "in=0" timeout=90
A expect gvar BanditMineBrutus_Day03 HTT_KolinaHasEnoughFood == 1 timeout=10
A expect gvar EVars_Lanzo_Intent AttackingBruna == 1 timeout=10

# The host, with three, is not kept in: she waves them through or says nothing; getting out is what matters.
A tp 22775,59455
A walk 0 1 0.3
sleep 5
A skip
sleep 4
A bye
A walk 0 1 6
A expect walked >= 60 timeout=9

A tpnear $lanzo 60 0
A walk -1 0 1
A expect dialogue contains "in=1" timeout=20
A skip
A expect dialogue contains "Lanzo! Stop it!" timeout=30
A choose Stop it
A skip
A expect dialogue contains "almost killed" timeout=20
A choose almost killed
A skip
A expect dialogue contains "in=0" timeout=90
B expect gvar BanditMineBrutus_Day03 EndConversationMaliAndLanzo == 1 timeout=10

# The client carries the mushrooms, so it cooks; only its mushrooms go into the pot.
B use CookingFire 3000
B skip
B expect dialogue contains "add mushrooms" timeout=20
B choose add mushrooms
B skip
B expect dialogue contains "(leave)" timeout=60
B choose leave
B skip
B expect dialogue contains "in=0" timeout=90
A expect gvar BanditMineBrutus_Day03 FinishedFood == 1 timeout=10
B expect items item_mushroom == 0 timeout=5

# ---- Night 3: the client sleeps. Day 4 (ruin, traps, relic) is jumped with the relic flag. ----
B tp 22686,60146
B use Interact_Bed 20
B expect dialogue contains "in=1" timeout=15
B skip
B expect dialogue contains "(say nothing)" timeout=90
B choose say nothing
B skip
B expect dialogue contains "in=0" timeout=90
A expect gvar BanditMineBrutus_DailyRoutines Day4 == 1 timeout=10
A setgvar BanditMineBrutus_Day04 GotRelic 1
B expect gvar BanditMineBrutus_DailyRoutines Evening == 1 timeout=10
B expect gvar EVars_Baltus_Intent SpeakingAfterRuin == 1 timeout=10

# ---- The breakout. Baltus by the host, Wind and the weapons by the client, Bruna and Mali by the host. ----
A tpnear $baltus 60 0
A walk -1 0 1
A expect dialogue contains "in=1" timeout=20
A skip
A expect dialogue contains "packed with traps" timeout=30
A choose packed with traps
A skip
A expect dialogue contains "snatched" timeout=20
A choose snatched
A skip
A expect dialogue contains "in=0" timeout=90
# Baltus leads to his hiding place and waits when the player falls behind: follow him.
A tpnear $baltus 80 0
sleep 8
A tpnear $baltus 80 0
sleep 8
A tpnear $baltus 80 0
sleep 8
A tpnear $baltus 80 0
sleep 8
A tpnear $baltus 80 0
sleep 8
A tpnear $baltus 80 0
sleep 8
A tpnear $baltus 80 0
sleep 8
A tpnear $baltus 80 0
sleep 8
A tpnear $baltus 80 0
sleep 8
A tpnear $baltus 80 0
sleep 8
A tpnear $baltus 80 0
sleep 8
A tpnear $baltus 80 0
sleep 8
A expect gvar EVars_Baltus_Intent SpeakingReachedRebellionSpot == 1 timeout=90
A tpnear $baltus 80 0
A walk -1 0 1
# A second approach, as for Hasso: the first can land before his intent is armed.
sleep 6
A tpnear $baltus 80 0
A walk -1 0 1
A expect dialogue contains "in=1" timeout=20
A skip
A expect dialogue contains "bust out NOW" timeout=30
A choose bust out NOW
A skip
A expect dialogue contains "need weapons" timeout=20
A choose need weapons
A skip
A expect dialogue contains "take care of Wind" timeout=20
A choose take care of Wind
A skip
A expect dialogue contains "in=0" timeout=90
B expect gvar QuestVars_BanditMineBrutus HTT_BaltusRecruteOther == 1 timeout=10
A camera

B tpnear $wind 60 0
B talk $wind
B skip
B expect dialogue contains "It's time" timeout=20
B choose It's time
B skip
B expect dialogue contains "guards have just withdrawn" timeout=20
B choose guards have just withdrawn
B skip
B expect dialogue contains "all of them" timeout=20
B choose all of them
B skip
B expect gvar QuestVars_BanditMineBrutus Day5_Rebellion_Wind == 1 timeout=20
B bye
A expect gvar QuestVars_BanditMineBrutus Day5_Rebellion_Wind == 1 timeout=10
B expect items misc_lockpick_simple >= 3 timeout=5

A tpnear $bruna 60 0
A talk $bruna
A skip
A expect dialogue contains "like, now" timeout=20
A choose like, now
A skip
A expect dialogue contains "storeroom" timeout=20
A choose storeroom
A skip
A expect gvar QuestVars_BanditMineBrutus HTTAboutPlanMali == 1 timeout=20
A bye
A tpnear $mali 60 0
A talk $mali
A skip
A expect dialogue contains "here for Bruna" timeout=20
A choose here for Bruna
A skip
A expect dialogue contains "bad shape" timeout=20
A choose bad shape
A skip
A expect gvar QuestVars_BanditMineBrutus MaliWentToBruna == 1 timeout=20
A bye
B expect gvar QuestVars_BanditMineBrutus MaliWentToBruna == 1 timeout=10
A camera

# The client fetches the weapons and walks Bruna to the meeting point.
B use PickUp_Mine_Weapons 3000
A expect gvar QuestVars_BanditMineBrutus GotWeapons == 1 timeout=10
B tp 23182,59600
B walk 0 1 1.5
A expect gvar QuestVars_BanditMineBrutus Day5_Rebellion_Bruna == 1 timeout=10
A expect gvar EVars_Bruna R_Day05_WaitForRebellion == 1 timeout=60
A expect gvar EVars_Wind R_Day05_WaitForRebellion == 1 timeout=60

# The client, holding the weapons, starts the revolt with Baltus.
B tpnear $baltus 60 0
B talk $baltus
B skip
B expect dialogue contains "Let's bust out." timeout=20
B choose Let's bust out.
B skip
B expect dialogue contains "Here are the weapons" timeout=20
B choose Here are the weapons
B skip
B expect dialogue contains "in=0" timeout=90
A expect gvar QuestVars_BanditMineBrutus StartedRevolte == 1 timeout=10
A expect gvar BanditMineBrutus_Rebellion StartRebellion == 1 timeout=10
A camera
B expect equipped contains weapon_sword_nailClub timeout=5

# ---- The gear from the stash chest (picked open). Host first; afterwards each player has only their own gear. ----
A give misc_lockpick_simple 1
A tp 22186,61380
A use Slated_Curly_Silver 300
sleep 3
A use Slated_Curly_Silver 300
sleep 2
A takeall
A expect items Armor_Chest_Leather == 1 timeout=10
A camera
B expect chest $chest contains item_honey timeout=5
B tp 22186,61380
B use Slated_Curly_Silver 300
sleep 3
B use Slated_Curly_Silver 300
sleep 2
B takeall
B expect items Consumable_Food_Honey == 3 timeout=10
A expect items Consumable_Food_Honey == 0 timeout=1
B expect items Armor_Chest_Leather == 0 timeout=1

# ---- The way out. The host leaves first: the exit volume outside waits for the whole party. ----
# During the revolt Mali, Lanzo and Aldrik confront passers-by depending on path: answered peacefully, the rest closed.
A skip
sleep 3
A choose ?gets to live
A skip
sleep 3
A choose ?We're not like Lanzo
A skip
sleep 3
A bye
# A player still "in a dialogue" is held by the dialogue camera, and the exit (camera-loaded) never switches on.
A expect dialogue contains "in=0" timeout=30
A tp 21617,60600
A camera
# Diagnostics for an intermittent host-only block: camera position, exit trigger loaded and bound.
A state
A inside Teleporter_BanditMine_Exit
A walk 0 -1 2
A expect state contains "pos=-12" timeout=15
A tp -1150,-7700
A walk 1 0 0.5
# The volume is hit-once: the host's entry uses it up and the mod holds the write while the client is inside;
# the last player in fires it in their own world, and the flag crosses.
sleep 5
A expect gvar QuestVars_BanditMineBrutus FinishedBanditMine == 0 timeout=1
B expect gvar QuestVars_BanditMineBrutus FinishedBanditMine == 0 timeout=1

B skip
sleep 3
B choose ?gets to live
B skip
sleep 3
B choose ?We're not like Lanzo
B skip
sleep 3
B bye
B expect dialogue contains "in=0" timeout=30
B tp 21617,60600
B walk 0 -1 2
B expect state contains "pos=-12" timeout=15
B tp -1150,-7700
B walk -1 0 0.5
A expect gvar QuestVars_BanditMineBrutus FinishedBanditMine == 1 timeout=15
B expect gvar QuestVars_BanditMineBrutus FinishedBanditMine == 1 timeout=15

# Baltus's last word frees the workers: the quest is done for both.
A tpnear $baltus 60 0
A walk -1 0 1
A expect dialogue contains "in=1" timeout=30
A skip
A expect gvar QuestVars_BanditMineBrutus WorkerFree == 1 timeout=30
B expect gvar QuestVars_BanditMineBrutus WorkerFree == 1 timeout=10
A expect gvar QuestVars_BanditMineBrutus QuestState == 3 timeout=10
B expect gvar QuestVars_BanditMineBrutus QuestState == 3 timeout=10
B expect journal Entry_BanditMineBrutus contains Entry_BanditMineBrutus timeout=5
B run coop_status
