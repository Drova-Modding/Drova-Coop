# The host's pause-menu button sends everyone back to the party checkpoint, on a hero whose mode allows going back.
# Hero 5 slot 0.

include session.coop

A run coop_status
# Every machine writes the checkpoint with the host's save (party slots 90-99).
A save 66
A expect counter checkpoint >= 1 timeout=20
B expect counter checkpoint >= 1 timeout=10

A expect gvar QuestVars_StolenWeapons PlayerCanJoinNemeton == 0 timeout=1
A setgvar QuestVars_StolenWeapons PlayerCanJoinNemeton 1
B expect gvar QuestVars_StolenWeapons PlayerCanJoinNemeton == 1 timeout=15

A pause
sleep 2
A expect click ModButton_coop_checkpoint contains clicked timeout=10
A expect counter gameovers >= 1 timeout=10
B expect counter gameovers >= 1 timeout=15
sleep 5
A wait world=1 timeout=240
B wait world=1 timeout=240
sleep 5
A expect gvar QuestVars_StolenWeapons PlayerCanJoinNemeton == 0 timeout=10
B expect gvar QuestVars_StolenWeapons PlayerCanJoinNemeton == 0 timeout=10
B expect state contains session=Joined timeout=30

# ---- Loading an older own save by hand takes everyone back too, each to their own copy of that round. ----
A setgvar QuestVars_StolenWeapons PlayerCanJoinNemeton 1
B expect gvar QuestVars_StolenWeapons PlayerCanJoinNemeton == 1 timeout=15
A load 5 66
A wait world=1 timeout=240
B expect counter gameovers >= 2 timeout=20
sleep 5
B wait world=1 timeout=240
sleep 5
A expect gvar QuestVars_StolenWeapons PlayerCanJoinNemeton == 0 timeout=10
B expect gvar QuestVars_StolenWeapons PlayerCanJoinNemeton == 0 timeout=10
B expect state contains session=Joined timeout=30
