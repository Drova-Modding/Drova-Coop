<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>annotations</Nullable>
        <LangVersion>12</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>DrovaCoopMod</RootNamespace>
        <AssemblyName>DrovaCoopMod</AssemblyName>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
        <GameDir Condition="'$(GameDir)'==''">C:\Program Files (x86)\Steam\steamapps\common\Drova - Forsaken Kin</GameDir>
    </PropertyGroup>

    <!--
        The API is the only coop dependency: nothing here names LiteNetLib, and nothing here needs to know
        whether the session runs direct or through a relay. Whether the transport exists at all is a
        property of the installed API build, checked at runtime through NetworkAccess.IsSupported.
    -->
    <ItemGroup>
        <Reference Include="Drova_Modding_API">
            <HintPath>$(GameDir)\Mods\Drova_Modding_API.dll</HintPath>
        </Reference>
        <Reference Include="MelonLoader">
            <HintPath>$(GameDir)\MelonLoader\net6\MelonLoader.dll</HintPath>
        </Reference>
        <Reference Include="Unity.InputSystem">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.InputSystem.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        <Reference Include="Il2Cppmscorlib">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppInterop.Runtime">
            <HintPath>$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
        </Reference>
    </ItemGroup>

    <Target Name="InstallToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\Mods')">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
    </Target>

</Project>
