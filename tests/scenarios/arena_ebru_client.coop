# The game's arena, Ebru booked and fought by the CLIENT (brawl leased to it): the host sees its traps, summons and
# shut gates, its own copy conjures nothing; the host's blows count; the win is shared.
# Needs hero 0 slot 65 in every profile (fixture_redtower_rl.scn).

default hero 0
default slotA 65
default slotB 65
include session.coop
set morvin 5b7d1640-817f-451a-adf9-d074e46a6a1d
set ebru d0f8d7a1-aa3e-4178-8ab8-54526c631d77
track $ebru

A run invincibility
B run invincibility
A run DayTime 10
B expect time contains "hour=10." timeout=15
A tp -1330,560

set p B
set canfight CanFightEbru
set accept AcceptEbruFight
set face MainFight_FaceEbru
include arena_main_book.part
# The outcome flag is MainFight_Participant_01_Won, written at the fight's end: reset it to the opposite now.
# WonEbru proves nothing: the game sets it when the fight starts.
B setgvar DAS_ArenaSystem MainFight_Participant_01_Won 1

A expect counter leasemirrored >= 1 timeout=30
A expect counter gatesapplied >= 1 timeout=20
A tpnear $ebru 40 0
sleep 20
B expect counter traplaid >= 1 timeout=60
A expect counter trapshown >= 1 timeout=10
A objects Trap_NPC_Ebru
B objects Trap_NPC_Ebru

A hit $ebru 2500
sleep 2
A hit $ebru 1500
B expect counter conjurecast >= 1 timeout=60
B expect actors 900 contains "Bloodquito" timeout=20
# The client-run fight's summons reach the host (LeaseSummons).
A expect counter summonsbuilt >= 1 timeout=20
B expect counter summonsbound >= 1 timeout=10
A expect actors 900 contains "Bloodquito" timeout=20
# The host's copy replays her cast but conjures nothing of its own.
A expect counter conjurecast >= 1 timeout=30
A expect counter spawnskipped >= 1 timeout=5
A actors 900
B actors 900

A ?hit $ebru 3000
sleep 2
B ?hit $ebru 3000
sleep 2
A ?hit $ebru 3000
B expect ai $ebru contains brawl=0 timeout=60
B expect gvar DAS_ArenaSystem MainFight_Participant_01_Won == 0 timeout=5
B expect ai me contains brawl=0 timeout=30
