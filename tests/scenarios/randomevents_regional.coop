# RandomEvents regional ambushes, rolled by the host only, the same creatures on both screens: the client's start is
# refused; a pool forced around the host; ambushes rolled around the client alone in three regions (RegionShare).
# Each pool skips 1 in 4. Bandit pools sit in boss areas and caves, blocked by default; randomevents_bandits.coop covers them.
# Needs RandomEvents from feature/coop-update and hero 0 slot 65 (fixture_redtower_rl.scn).
# Probed spots: Forest -2000,-4000; Auwald 2000,0; Leuchtwald -6000,-4000; Heide -2132,-5262; Ruins 20,1170 (boss area, blocked).

default hero 0
default slotA 65
default slotB 65
include session.coop
A tp -2000,-4000
B tp -1960,-4000
sleep 15
A worldevent
B worldevent
A expect counter regionstaken >= 1 timeout=20

# The client cannot roll one.
B expect worldevent region Forest contains "none started" timeout=5

# Monsters around the host, in the Forest.
capture base A counter spawnsannounced
A expect worldevent region Forest,Auwald,Leuchtwald,Heide,River !contains "none started" timeout=5
sleep 20
A expect counter spawnsannounced != $base timeout=20
capture monsters A counter spawnsannounced
B expect counter spawnsbuilt == $monsters timeout=20
A actors 700
B actors 700

# The client alone: the host waits in the Ruins (blocked for itself), the client walks three regions.
A tp 20,1170
sleep 5
capture before A counter spawnsannounced
B tp 2000,0
sleep 3
B worldevent
sleep 15
B tp -6000,-4000
sleep 3
B worldevent
sleep 15
B tp -2132,-5262
sleep 3
B worldevent
sleep 15
A expect counter spawnsannounced != $before timeout=20
capture all A counter spawnsannounced
B expect counter spawnsbuilt == $all timeout=20
B actors 700
A worldevent
