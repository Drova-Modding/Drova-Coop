# The client turns busy between "ready" and commit: it skips the write and says so; the host retries once it is free.
# A 2 s link delay holds that window open. Needs hero 0 slot 60 (Remnants camp, chapter 1).

default hero 0
default slotA 60
default slotB 60
set net 2000-2000
include session.coop

# Dylara stands in open ground: near Kilian a non-member trespasses, and a crime blocks saving.
set dylara 53f6f5d8-d08e-46d0-b750-d624ead30595
B tpnear $dylara 0 80
sleep 3

# The commit is still in flight when the client starts a talk.
A save 66
A expect counter checkpoint >= 1 timeout=30
B expect talk $dylara contains talking timeout=5
B expect dialogue contains "in=1" timeout=5
sleep 6
B expect counter checkpoint == 0 timeout=1

# Free again: the host's new round gives both the same checkpoint.
B ?bye
B expect dialogue contains "in=0" timeout=30
A expect counter checkpoint >= 2 timeout=60
B expect counter checkpoint >= 2 timeout=15
