# The game's arena, Ada (fog fighter): the client sees the host's fight (fog, shared doppelgangers, shut gates); the win is shared.
# Needs hero 0 slot 65 in every profile (fixture_redtower_rl.scn).

default hero 0
default slotA 65
default slotB 65
include session.coop
set morvin 5b7d1640-817f-451a-adf9-d074e46a6a1d
set ada fbddeebd-5a35-4282-ae3c-f54e17371aaa
track $ada

A run invincibility
B run invincibility
A run DayTime 10
B expect time contains "hour=10." timeout=15
B tp -1330,560

set p A
set canfight CanFightAda
set accept AcceptAdaFight
set face MainFight_FaceAda
include arena_main_book.part
# Won<Name> can already be set at booking (WonEbru turns 1 then): reset it to the opposite of the expected end.
A setgvar QuestVars_DAS_WayToArenaMaster WonAda 0
A setgvar DAS_ArenaSystem MainFight_Participant_01_Won 1
B expect gvar QuestVars_DAS_WayToArenaMaster WonAda == 0 timeout=10

B expect counter gatesapplied >= 1 timeout=20
B tpnear $ada 40 0
# The host stands off her fog and the client in it: her fog is a ring round the ring, and it must wake for the client
# too (GuardReach drives it for a teammate's body). It is what brings her doppelgangers.
A tpnear $ada -250 0
sleep 20
A expect foglets 800 contains "AdaFog_NonFadeable mode=None defeated=0 inside=0" timeout=5
# Her fog stands in the client's ring too.
B expect foglets 800 contains "AdaFog_Fadeable_PreFight mode=Active" timeout=20

B hit $ada 2000
sleep 3
B hit $ada 1000
B tpinto AdaFog_NonFadeable/
B foglets 800
# Her ring fog arms on AdaMoreFog, which her AI raises on a roll once hurt (vanilla, sometimes not for minutes).
# Raised here so the run checks the co-op part: the ring wakes on the host for the client standing in it.
A setgvar DAS_ArenaSystem AdaMoreFog 1
A expect foglets 800 !contains "AdaFog_NonFadeable mode=None" timeout=20
sleep 15
A foglets 800
B foglets 800
A actors 900
B actors 900
# Doppelgangers are the host's, shared. She casts when her AI picks it, not on a hit, so wait long.
A expect counter conjurecast >= 1 timeout=90
A expect counter spawnshared >= 1 timeout=10
B expect counter spawnskipped >= 1 timeout=10
A gvar DAS_ArenaSystem AdaMoreFog

B ?hit $ada 3000
sleep 2
A ?hit $ada 3000
sleep 2
B ?hit $ada 3000
A expect ai $ada contains brawl=0 timeout=60
A expect gvar DAS_ArenaSystem MainFight_Participant_01_Won == 0 timeout=5
A expect gvar QuestVars_DAS_WayToArenaMaster WonAda == 1 timeout=15
B expect gvar QuestVars_DAS_WayToArenaMaster WonAda == 1 timeout=15
# After the fight the fog goes in both worlds.
sleep 20
A foglets 800
B foglets 800
