# Three instances over a delayed link: A hosts, B and C join, for what needs two clients (relayed blows).
# Profile C is a copy of Sprint_24, like A and B.
default net 40-120
default hero 5
default slotA 0
default slotB 0
default slotC 0
launch A --net-delay $net
launch B --net-delay $net
launch C --net-delay $net
A wait ready=1 timeout=240
B wait ready=1 timeout=240
C wait ready=1 timeout=240
A wait saves=separate timeout=1
B wait saves=separate timeout=1
C wait saves=separate timeout=1
A load $hero $slotA
B load $hero $slotB
C load $hero $slotC
A wait world=1 timeout=240
B wait world=1 timeout=240
C wait world=1 timeout=240
default loot instanced
A lootmode $loot
A host
A wait code=* timeout=60
B join $A.code
A wait players=2 timeout=60
C join $A.code
A wait players=3 timeout=60
B wait players=3 timeout=60
C wait players=3 timeout=60
