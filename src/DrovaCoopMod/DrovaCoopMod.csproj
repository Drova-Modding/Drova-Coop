<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>annotations</Nullable>
        <LangVersion>12</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>DrovaCoopMod</RootNamespace>
        <AssemblyName>DrovaCoopMod</AssemblyName>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
        <Version>0.2.0</Version>
    </PropertyGroup>

    <!--
        The transport comes from the API (NetworkAccess.IsSupported), so nothing here names LiteNetLib.
        The wire contract has no game references, so CI can build and test it without the game.
    -->
    <ItemGroup>
        <ProjectReference Include="..\DrovaCoopMod.Protocol\DrovaCoopMod.Protocol.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Drova_Modding_API">
            <HintPath>$(ApiAssembly)</HintPath>
        </Reference>
        <Reference Include="MelonLoader">
            <HintPath>$(GameDir)\MelonLoader\net6\MelonLoader.dll</HintPath>
        </Reference>
        <Reference Include="Unity.InputSystem">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.InputSystem.dll</HintPath>
        </Reference>
        <!-- Loads a shared cutscene's data on a machine that never streamed it. -->
        <Reference Include="Unity.Addressables">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.Addressables.dll</HintPath>
        </Reference>
        <Reference Include="Unity.ResourceManager">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.ResourceManager.dll</HintPath>
        </Reference>
        <!-- SaveCurrentAt returns a UniTask. The checkpoint writes through it. -->
        <Reference Include="Il2CppUniTask">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppUniTask.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- CS_CutsceneData's base type. -->
        <Reference Include="Il2CppSirenix.Serialization">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSirenix.Serialization.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        <!-- Name tags and the session window are drawn with IMGUI. -->
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.IMGUIModule.dll</HintPath>
        </Reference>
        <!-- Canvas, which a puppet's inherited interface is switched off at. -->
        <Reference Include="UnityEngine.UIModule">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.UIModule.dll</HintPath>
        </Reference>
        <!-- TextAnchor and FontStyle for the GUIStyles. -->
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.TextRenderingModule.dll</HintPath>
        </Reference>
        <!-- AudioClip: a teammate's voiced line is played here by the clip's name (SpokenLines). -->
        <Reference Include="UnityEngine.AudioModule">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.AudioModule.dll</HintPath>
        </Reference>
        <!-- Collider2D and Rigidbody2D, which a remote body has to be taken out of. -->
        <Reference Include="UnityEngine.Physics2DModule">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.Physics2DModule.dll</HintPath>
        </Reference>
        <!-- The interop HashSet. -->
        <Reference Include="Il2CppSystem.Core">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSystem.Core.dll</HintPath>
        </Reference>
        <Reference Include="Il2Cppmscorlib">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
        </Reference>
        <!-- NodeCanvas: the dialogue trees and the base of the range check EnemyPerception asks again. -->
        <Reference Include="Il2CppParadoxNotion">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppParadoxNotion.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppInterop.Runtime">
            <HintPath>$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!--
        The game's own assemblies. Actor's base chain runs through Gilzoide.UpdateManager and Just2D, so
        without them every member Actor inherits from MonoBehaviour fails to resolve.
    -->
    <ItemGroup>
        <Reference Include="Il2CppDrova">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppDrova.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppFileHandling">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppFileHandling.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppGilzoide.UpdateManager">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppGilzoide.UpdateManager.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppJust2D">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppJust2D.dll</HintPath>
        </Reference>
        <!-- LocalizationDB: the teammate talk menu answers its own lines there. -->
        <Reference Include="Il2CppJust2D.Localization">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppJust2D.Localization.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!--
            OW_ReferencePoint and OW_Root: the chunk streaming system. A remote body needs a reference point
            of its own or the world only exists around whoever is local.
        -->
        <Reference Include="Il2CppOpenWorld.Runtime">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppOpenWorld.Runtime.dll</HintPath>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(GameDir)\MelonLoader\net6\0Harmony.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!--
        MelonInfo needs the version from Directory.Build.props as a compile-time constant.
        No Inputs/Outputs on purpose: skipping the target would also skip adding the Compile item.
    -->
    <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile;CoreCompile">
        <ItemGroup>
            <BuildInfoLine Include="// &lt;auto-generated /&gt;" />
            <BuildInfoLine Include="// Generated from &lt;Version&gt; in Directory.Build.props. Do not edit." />
            <BuildInfoLine Include="namespace DrovaCoopMod" />
            <BuildInfoLine Include="{" />
            <BuildInfoLine Include="    internal static class BuildInfo" />
            <BuildInfoLine Include="    {" />
            <BuildInfoLine Include="        internal const string Version = &quot;$(Version)&quot;%3B" />
            <BuildInfoLine Include="    }" />
            <BuildInfoLine Include="}" />
        </ItemGroup>

        <WriteLinesToFile
            File="$(IntermediateOutputPath)BuildInfo.g.cs"
            Lines="@(BuildInfoLine)"
            Overwrite="true"
            WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
        </ItemGroup>
    </Target>

    <!-- The protocol assembly goes to UserLibs, since MelonLoader treats everything in Mods as a melon. -->
    <Target Name="InstallToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\Mods')">
        <MakeDir Directories="$(GameDir)\UserLibs" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
        <Copy SourceFiles="$(TargetDir)DrovaCoopMod.Protocol.dll" DestinationFolder="$(GameDir)\UserLibs" />
    </Target>

</Project>
