B ?hit Shadow 1500
sleep 2
A expect gvar GVars_Fight_GreatTuskFight AfterMainFight_Finished == 1 timeout=120
# Darwin's capture talk runs on into the aftermath ("(sink to your knees)") through a blackout cutscene, which ends the
# first-answer skip at times - so the talk step below skips again if the question is still open.
sleep 6
A skip first
B skip first
A expect gvar GVars_Fight_GreatTuskFight Credits_Finished == 1 timeout=240
include tusk_talk.part
A expect gvar QuestVars_ExpeditionRuinenlager BossKilled == 1 timeout=10
B expect gvar QuestVars_ExpeditionRuinenlager BossKilled == 1 timeout=10
A expect gvar QuestVars_ExpeditionRuinenlager LindonDead == 1 timeout=10
B expect gvar QuestVars_ExpeditionRuinenlager LindonDead == 1 timeout=10
A expect gvar GVars_Fight_GreatTuskFight CaughtBoar == 1 timeout=10
B expect gvar GVars_Fight_GreatTuskFight CaughtBoar == 1 timeout=10
A expect gvar QuestVars_ExpeditionRuinenlager LeaveLeuchtwald_Start == 1 timeout=30
B expect gvar QuestVars_ExpeditionRuinenlager LeaveLeuchtwald_Start == 1 timeout=30

# ---- The forest dies - in both worlds, live. ----
A expect gvar WorldVars Leuchtwald_Destroyed == 1 timeout=10
B expect gvar WorldVars Leuchtwald_Destroyed == 1 timeout=10
A expect objects Veil_Big_00 == 0 timeout=30
B expect objects Veil_Big_00 == 0 timeout=30
A expect objects Root_Leuchtwald_Dying >= 100 timeout=30
B expect objects Root_Leuchtwald_Dying >= 100 timeout=30
B expect objects Luts_Leuchtwald_Destroyed list contains "Luts_Leuchtwald_Destroyed=1" timeout=30
# The cast ends with the capture, in both worlds.
# unverified: Darwin's resolved cast action name (the substring of Mombert's AA_Flow_InfiniteSpell)
A expect ai $darwin !contains InfiniteSpell timeout=30
# unverified: Darwin's resolved cast action name (the substring of Mombert's AA_Flow_InfiniteSpell)
B expect ai $darwin !contains InfiniteSpell timeout=30
# Lindon falls in the fight, as Gradan does on the Nemeton side: a story flag and a corpse prop, the actor itself stays.
A expect gvar QuestVars_ExpeditionRuinenlager LindonDead == 1 timeout=10
B expect gvar QuestVars_ExpeditionRuinenlager LindonDead == 1 timeout=10
