# coop_arena: going down calls a round; both restart whole after a no-damage breather; the score crosses.
# Going down in the ring never ends the run; the ring's rule stops at its edge.
# Hero 0 slot 60, friendly fire off.

default hero 0
default slotA 60
default slotB 60
include session.coop

A ff off
# Carried in: what the fight uses comes back (checked below).
A give item_potion_health_0 3
B give item_potion_health_0 3
A tp 20,1170
B tp 40,1170
sleep 3
A run coop_arena 100
A run coop_arena start
A expect run coop_status contains "arena: marked" timeout=5
B expect run coop_status contains "arena: marked" timeout=10
B expect run coop_status contains "you are inside" timeout=5
# Let the circle and both bodies settle on both machines.
sleep 2

# ---- Round 1: the host downs the client. ----
A hit DrovaCoop.Remote 5000
# One of two fighters down: the round is called at once, so the down lasts a fraction of a second.
A expect run coop_status contains "1 called" timeout=10
B expect run coop_status contains "rounds won" timeout=10
# Up at once, not after the downed clock.
B expect ai me !contains mode=KnockOut timeout=4
B expect health me cur >= 89 timeout=5
A expect health me cur >= 89 timeout=5
# The breather: a blow does nothing.
A hit DrovaCoop.Remote 30
sleep 1
B expect health me cur >= 89 timeout=1
# After it, blows land again.
sleep 4
A hit DrovaCoop.Remote 30
B expect health me cur <= 80 timeout=10

# ---- Round 2: both down is still only a round. ----
A hit DrovaCoop.Remote 5000
A hit me 5000
sleep 3
A expect counter gameovers <= 0 timeout=1
B expect counter gameovers <= 0 timeout=1
A expect run coop_status contains "2 called" timeout=10
B expect ai me !contains mode=KnockOut timeout=10
A expect ai me !contains mode=KnockOut timeout=10

# ---- Potions drunk in the ring come back: B drinks one, has three on leaving. ----
sleep 4
B useitem item_potion_health_0
B expect items item_potion_health_0 == 2 timeout=10

# ---- Outside the ring the session rule counts again. ----
B tp 20,1470
sleep 2
B expect run coop_status contains "you are outside" timeout=5
A hit DrovaCoop.Remote 30
sleep 3
B expect health me cur >= 89 timeout=1

B expect items item_potion_health_0 == 3 timeout=5
B expect counter arenarefunded >= 1 timeout=1
# Drunk outside the ring, it stays drunk.
B useitem item_potion_health_0
B expect items item_potion_health_0 == 2 timeout=10
sleep 3
B expect items item_potion_health_0 == 2 timeout=1

# ---- Closed: score read out, ring gone, the host's potion comes back. ----
A useitem item_potion_health_0
A expect items item_potion_health_0 == 2 timeout=10
A run coop_arena off
B expect run coop_status !contains "arena: marked" timeout=10
A expect items item_potion_health_0 == 3 timeout=5
