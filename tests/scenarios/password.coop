# A password-protected relay session: hosted and joined with the password, sealed end to end, and nothing sent too early
# or too big for the session. A wrong password is refused with its reason, and the right one then joins again.
# The join token is derived off the main thread (API hardening, 2026-09-14): a session that never connects means the
# deferred connect never ran.

default password s3cret
include session.coop

A expect netstats contains encrypted=1 timeout=10
B expect netstats contains encrypted=1 timeout=10
# Some traffic both ways before the counters are read.
B walk 1 0 2
A walk -1 0 2
B expect walked >= 20 timeout=10
A expect teammate <= 2000 timeout=10
A expect netstats contains "oversized=0 nosession=0 undecryptable=0 malformed=0" timeout=5
B expect netstats contains "oversized=0 nosession=0 undecryptable=0 malformed=0" timeout=5

# ---- A wrong password: refused, and said why. ----
B leave
A expect state contains players=1 timeout=30
B password wrong1
B join $A.code
B expect state contains session=Failed timeout=30
B expect run coop_status contains "Wrong session password" timeout=5

# ---- The right one joins again. ----
B password s3cret
B join $A.code
A expect state contains players=2 timeout=60
B expect state contains players=2 timeout=60
B expect netstats contains encrypted=1 timeout=10
A expect netstats contains "undecryptable=0" timeout=5

# Leave no password behind for the next scenario.
B leave
A password none
B password none
A shot
B shot
