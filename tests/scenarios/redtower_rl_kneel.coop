B hit Golem 1500
A expect gvar QuestVars_RedTowerStage02 KilledEnemies_Wave01 == 1 timeout=30
A hit Draugr 1500
B hit Draugr 1500
A hit Draugr 1500
B hit Draugr 1500
A hit Draugr 1500
B hit Draugr 1500
A hit Draugr 1500
