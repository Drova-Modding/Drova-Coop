# The host-started half of brawl_team.coop: the host defies the boss and brawls the MiningChef on its own machine,
# and the client joins in. Its copy must accept the client's swings (TeamBrawls marks it hostile), the blows must
# reach the host's live brawl, and the host's health broadcast gives the client's copy its wounds and health bar.
# Needs hero 2 slot 2 (see mine.coop).

include mine_entry.part
A tpnear $hasso 60 0
A walk -1 0 1
A expect dialogue contains "saved_something_for_you" timeout=15
A skip
A expect dialogue contains "choices=0:My name is" timeout=20
A choose My name is
A skip
A expect dialogue contains "Thank you." timeout=15
A choose Thank you.
A skip
A expect dialogue contains "in=0" timeout=90
B expect gvar BanditMineBrutus_Day01 HassoReachedCookingArea == 1 timeout=10
B expect gvar BanditMineBrutus_Day01 FollowHassoToWorkingArea == 1 timeout=10

# ---- Day 1: the boss, by the host, who talks back and gets a brawl with the MiningChef. ----
B expect gvar EVars_Hasso_Intent ReachedWorkingArea == 1 timeout=60
A tpnear $hasso 60 0
A walk -1 0 1
A expect dialogue contains "in=1" timeout=10
A skip
A expect dialogue contains "choices=0:Give me back my gear!" timeout=20
A choose Give me back
A skip
A expect dialogue contains "choices=0:" timeout=20
A choose ?Got it.
A skip
A expect dialogue contains "Nobody calls you boss" timeout=15
# The client stands ready beside the boss before the brawl starts.
B tpnear $chef 30 0
B stance combat
A choose Nobody calls you boss
A skip
A expect dialogue contains "in=0" timeout=90

B expect counter brawljoined >= 1 timeout=10

# ---- The client swings at the chef the host is brawling. ----
B look $chef
B press primaryattack
sleep 0.8
B look $chef
B press primaryattack
A expect health $chef cur <= 749 timeout=5
B expect health $chef cur <= 749 timeout=5

# ---- The client joined the host's brawl on the host's machine. ----
A expect counter arenajoined >= 1 timeout=10

# ---- The chef down ends it, the players' side winning. ----
B hit $chef 2000
A expect ai $chef contains "brawl=0" timeout=30
A expect counter gameovers == 0
