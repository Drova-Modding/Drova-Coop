# Party checkpoint: any save writes slot 99 on every machine, only when all could save; a lost run sends both back.
# Needs hero 0 slot 60 (Remnants camp, chapter 1).

default hero 0
default slotA 60
default slotB 60
include session.coop

# Dylara stands in open ground: near Kilian a non-member trespasses, and a crime blocks saving.
set dylara 53f6f5d8-d08e-46d0-b750-d624ead30595

# The client writes the checkpoint with the host's save.
A save 66
A expect counter checkpoint >= 1 timeout=20
B expect counter checkpoint >= 1 timeout=10

# The client in a dialogue cannot save: the round is dropped and the checkpoint stays where it was...
# (The host stays put, or it would be the one in a dialogue.)
B tpnear $dylara 0 80
sleep 3
B expect talk $dylara contains talking timeout=20
B expect dialogue contains "in=1" timeout=15
A save 66
sleep 8
A expect counter checkpoint <= 1 timeout=1
B expect counter checkpoint <= 1 timeout=1
# ...until the client is free again, when the host's retry writes it.
B ?bye
B expect dialogue contains "in=0" timeout=30
A expect counter checkpoint >= 2 timeout=40
B expect counter checkpoint >= 2 timeout=10

# A flag set after the checkpoint is undone by the lost run, in both worlds.
A expect gvar QuestVars_StolenWeapons PlayerCanJoinNemeton == 0 timeout=1
A setgvar QuestVars_StolenWeapons PlayerCanJoinNemeton 1
B expect gvar QuestVars_StolenWeapons PlayerCanJoinNemeton == 1 timeout=15

A hit me 5000
B hit me 5000
A expect counter gameovers >= 1 timeout=10
B expect counter gameovers >= 1 timeout=15
sleep 5
A wait world=1 timeout=240
B wait world=1 timeout=240
sleep 5
A expect state contains session=Hosting timeout=10
B expect state contains session=Joined timeout=30
A expect gvar QuestVars_StolenWeapons PlayerCanJoinNemeton == 0 timeout=10
B expect gvar QuestVars_StolenWeapons PlayerCanJoinNemeton == 0 timeout=10
A expect ai me !contains mode=KnockOut timeout=10
B expect ai me !contains mode=KnockOut timeout=10

# Hero 0 is Immersive (no going back by choice): no checkpoint button. checkpoint_button.coop covers it.
A run coop_status
A expect run coop_status contains "going back by choice is off" timeout=5
A pause
sleep 2
A expect click ModButton_coop_checkpoint contains "no active button" timeout=5
