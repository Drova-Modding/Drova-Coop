# Builds the Red Tower fixture: hero 1 slot 50 = slot 4 with the City Dungeon finished and the Knawd Moor chain done (Nemeton side), Molvina's
# hand-over still to come. Saved and reloaded, then checked NPC by NPC.
#
# Every flag the chain writes, in the order the game writes it (quest graph waits: the leader's order, the machine,
# the crystals), and then the ports: the game's story observers port the Nemeton NPCs to their new routines once,
# when the flag flips in a running scene. A flag set here gets the routine right and leaves the body where it was -
# Lio stays in the druid house, and the hand-over cutscene waits for him forever.
#
# Run once, then copy Sprint_24_A\Hero_01\Savegame_50 into Sprint_24_B and Sprint_24_C.

launch A
A wait ready=1 timeout=240
A wait saves=separate timeout=1
A load 1 4
A wait world=1 timeout=240

set molvina 19d2fee9-aaca-453a-a56d-f8f841b0f719
set lio c7419000-64e9-4b41-879f-2348a0dc793f
set henik 1d68e5c7-bf2a-4ca5-9366-ca3b27404f08
set mombert 8fe6b401-4600-4662-9702-b3cc379f269b
set karotte b275519f-3555-4104-890a-c6b1c3726e1a
set asmus 8678e993-82fb-4d0e-8e49-dc8d56d7c9ca
set helma c28bdf87-9150-473a-bd9f-860ea627bdf2
set kerr 8b002d33-45d6-4c53-829c-b73b24984410
set laudine 6f995a7d-c08e-4bf5-bdac-a37ff5d0da26
set guard1 d9f7fd8c-8be3-4486-8a51-300a7aaa5793
set guard2 114be885-7feb-420d-ab93-77d0657e7cc4

# Slot 4 stands inside the City Dungeon (temple and secret area found, crystal not taken): its end first. The
# crystal flips the End-City-Dungeon observer, which ports the Nemeton NPCs out to the plaza.
A setgvar QuestVars_CityDungeon GotCrystal 1
sleep 1
A setgvar QuestVars_CityDungeon GaveLeaderCrystal 1
sleep 1
A expect gvar QuestVars_CityDungeon QuestState == 3 timeout=5
A setgvar QuestVars_LoadCrystals HTT_LeaderGoToFleischmoor 1
sleep 1
A setgvar EVars_Henik_Intent HenikWaitingFleischMoor 0
# EndMutation before BeginMutation, or Mombert plays the mutation on the spot.
A setgvar EVars_Mombert EndMutation 1
A setgvar EVars_Mombert MutationState 3
A setgvar EVars_Mombert MutationWaitState 2
A setgvar EVars_Mombert BeginMutation 1
A setgvar EVars_Mombert FleischMoorFacetChange 1
A setgvar QuestVars_LoadCrystals KilledAllEnemies 1
A setgvar QuestVars_LoadCrystals Nemeton_HTT_HenikAboutMombert 1
# AfterExpedition before ActivatedMachine, or its journal entry is lost.
A setgvar QuestVars_LoadCrystals AfterExpedition 1
A setgvar QuestVars_LoadCrystals AmountOfEnterCrystals 3
sleep 1
A setgvar QuestVars_LoadCrystals ActivatedMachine 1
sleep 1
A setgvar GVars_MoorDungeon_Shield MainStationActivated 1
A setgvar GVars_MoorDungeon_Shield FinishFirstDialog 1
A setgvar GVars_MoorDungeon_Shield ShieldFullyCharged_SW 1
A setgvar GVars_MoorDungeon_Shield ShieldFullyCharged_SE 1
A setgvar GVars_MoorDungeon_Shield ShieldFullyCharged_NE 1
A setgvar GVars_MoorDungeon_Shield NumShieldsCharged 3
A setgvar GVars_MoorDungeon_Shield MainStationFullyCharged 1
A setgvar GVars_MoorDungeon_Shield MainStationFullyCharged_PlayerInRange 1
A setgvar GVars_MoorDungeon_Shield MainStationCollected 1
A setgvar QuestVars_LoadCrystals GotLoadedCrystals 1
sleep 1
A setgvar EVars_Henik_Intent KilledEnemiesFleischmoor 0
A setgvar EVars_Henik_Intent HenikWaitingFleischMoor 0
A setgvar EVars_Molvina_Intent TalkPlayerAfterFleischmoor 1
A expect journal LoadCrystals contains Entry_LoadCrystals_Entry_03 timeout=10
A expect gvar QuestVars_LoadCrystals QuestState == 2 timeout=5

# What the machine gave: the three charged crystals (Molvina takes them), and Dorian's heirloom.
A give Misc_Energycrystal_Auwald_Charged 1
A give Misc_Energycrystal_Brutus_Charged 1
A give Misc_Energycrystal_CityDungeon_Charged 1
A give Armor_Trinket_DoriansHeirloom 1

A save 50
sleep 8
A load 1 50
sleep 10
A wait world=1 timeout=240

# The ports the story observers would have made, after the reload so the routines are the new ones.
A port $molvina
A port $lio
A port $helma
A port $kerr
A port $laudine
A port $guard1
A port $guard2
A port $mombert
A port $henik
A port $karotte
A port $asmus
sleep 3

# Every NPC of the hand-over and the ritual on its after-the-Knawd-Moor routine, and there.
A tp 4600,-3500
sleep 5
A expect ai $molvina contains NemetonEvent/R_Molvina_CopyEndCityDungeon timeout=10
A expect ai $lio contains NemetonEvent/R_Lio_IDLE_EndCityDungeon timeout=10
A expect ai $helma contains NemetonEvent/R_Helma_CopyEndCityDungeon timeout=10
A expect ai $kerr contains NemetonEvent/R_Kerr_IDLE_EndCityDungeon timeout=10
A expect ai $laudine contains NemetonEvent/R_Laudine_CopyEndCityDungeon timeout=10
A expect ai $asmus contains NemetonEvent/R_Asmus_EndFleischDungeon timeout=10
A expect ai $henik contains R_Henik_EndFleischDungeon timeout=10
A expect ai $mombert contains R_Mombert_Bed_EndFleischDungeon timeout=10
A expect ai $karotte contains R_Karotte_StayMombert_EndFleischDungeon timeout=10

A save 50
sleep 8
