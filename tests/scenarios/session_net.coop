# session.coop over a delayed link: both games hold every received packet back $net ms (minMs-maxMs), so
# two messages can land in one frame and unreliable ones can overtake each other, as on a real connection.
default net 40-120
# Shared setup: two instances in one session. Included by the other scenarios.
#
# Each instance loads from its own profile folder, LocalLow\Just2D\Drova\Sprint_24_A and _B, which start
# as copies of the ordinary Sprint_24. Override the save with -D hero=N -D slotA=N -D slotB=N.

default hero 5
default slotA 0
default slotB 0

launch A --net-delay $net
launch B --net-delay $netW
A wait ready=1 timeout=240
B wait ready=1 timeout=240

# Never load anything into an instance that would write the player's real savegames.
A wait saves=separate timeout=1
B wait saves=separate timeout=1

A load $hero $slotA
B load $hero $slotB
A wait world=1 timeout=240
B wait world=1 timeout=240

# The host's loot rule (instanced or shared) travels with the session. -D loot=shared, or a scenario's own default.
default loot instanced
A lootmode $loot
A host
A wait code=* timeout=60
B join $A.code
A wait players=2 timeout=60
B wait players=2 timeout=60
