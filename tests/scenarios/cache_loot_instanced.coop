# Per-player loot from smashed boxes, taken host, client, host, client: each take leaves the other player's spill alone,
# and nothing taken comes back.

default loot instanced
include cache_loot.part
capture b0 B spill

capture item A spillname 0
A use $item 300
sleep 3
capture a1 A spill
A expect spill <= 2 timeout=1
B expect spill == $b0 timeout=1

capture item B spillname 0
B use $item 300
sleep 3
capture b1 B spill
B expect spill <= 2 timeout=1
A expect spill == $a1 timeout=1

capture item A spillname 0
A use $item 300
sleep 3
capture a2 A spill
A expect spill <= 1 timeout=1
B expect spill == $b1 timeout=1

capture item B spillname 0
B use $item 300
sleep 3
capture b2 B spill
B expect spill <= 1 timeout=1
A expect spill == $a2 timeout=1

sleep 10
A expect spill == $a2 timeout=1
B expect spill == $b2 timeout=1
