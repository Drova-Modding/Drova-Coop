# Client-to-client blows (the host only relays): inside the host's arena with friendly fire off, a sword blow and
# a poison cry from B reach C; once the arena is down, neither does.

include session3_net.coop

A give item_potion_flow_1 4
B give cons_flow_venomCry 3
C give item_potion_health_0 10
B expect equip weapon_sword_longsword contains "equipped" timeout=6
A ff off
C expect state contains "ff=off" timeout=10

A tp -2040,-5262
A run coop_arena 300
A tp -2040,-4600
B tp -2040,-5262
C tp -2000,-5262
sleep 3
B look DrovaCoop.Remote.2
B stance combat
sleep 2
C expect health me == 40/40 timeout=2
# Aimed where B's copy of C stands after the teleports; swung twice in case the first came before that copy caught up.
B look DrovaCoop.Remote.2
B press primaryattack
sleep 2
B tp -2040,-5262
B look DrovaCoop.Remote.2
B press primaryattack
sleep 2.5
C expect counter dmgapplied >= 1 timeout=5
# The blow (44 raw) downs unarmored C, ending the round and healing everyone: the round call is the proof, not C's health.
A expect run coop_status contains "1 called" timeout=10

# Same for an effect: B's poison cry lands once on C.
sleep 6
C useitem item_potion_health_0
sleep 5
B tp -2040,-5262
C tp -2000,-5262
sleep 2
B look DrovaCoop.Remote.2
B expect useitem cons_flow_venomCry 0.4 contains "used" timeout=6
C expect effects me == StatusEffect_Poison timeout=5

# Arena down: the same blow no longer lands.
A run coop_arena off
sleep 12
C useitem item_potion_health_0
sleep 5
C useitem item_potion_health_0
sleep 5
C expect health me == 40/40 timeout=5
B tp -2040,-5262
C tp -2000,-5262
sleep 2
B look DrovaCoop.Remote.2
B press primaryattack
sleep 2.5
C expect health me == 40/40 timeout=3
