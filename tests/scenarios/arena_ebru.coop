# The game's own arena: Ebru, the trap-layer, fought by the host with the client at its side. The fight is the host's
# (the arena's flags are per machine); what the client sees of it must be the host's fight:
# - her traps: the host's, shown where they lie, and none of the client's own copy's (which replays her throws);
# - her summons (rippers, insects): the host's, shared, and none conjured by the client's copy;
# - the gate barriers: shut on both screens while the fight is on;
# and the client's blows count in it: together they bring her down and the win is shared.
#
# Needs hero 0 slot 65 in every profile (fixture_redtower_rl.coop).

default hero 0
default slotA 65
default slotB 65
include session.coop
set morvin 5b7d1640-817f-451a-adf9-d074e46a6a1d
set ebru d0f8d7a1-aa3e-4178-8ab8-54526c631d77
track $ebru

A run invincibility
B run invincibility
A run DayTime 10
B expect time contains "hour=10." timeout=15
B tp -1330,560

set p A
set canfight CanFightEbru
set accept AcceptEbruFight
set face MainFight_FaceEbru
include arena_main_book.part
# The outcome is MainFight_Participant_01_Won (1: the champion's side won), written as the fight ends; it is reset
# now the fight is on to the opposite of what the end must show. WonEbru proves nothing: the game itself sets it as
# the fight starts (measured solo too), never at its end.
A setgvar DAS_ArenaSystem MainFight_Participant_01_Won 1

# The gate shut on the client too.
B expect counter gatesapplied >= 1 timeout=20
B expect objects ActiveFight_Blocker list contains "=1" timeout=5

# The client joins her in the ring.
B tpnear $ebru 40 0
sleep 20
A expect counter traplaid >= 1 timeout=60
B expect counter trapshown >= 1 timeout=10
B counter trapwithdrawn
A objects Trap_NPC_Ebru
B objects Trap_NPC_Ebru

# Hurt, she calls her rippers and insects: the host's, shared - the client's copy conjures none.
B hit $ebru 2500
sleep 2
B hit $ebru 1500
A expect counter spawnshared >= 1 timeout=60
B expect counter spawnskipped >= 1 timeout=30
A actors 900
B actors 900

# Together they bring her down.
B ?hit $ebru 3000
sleep 2
A ?hit $ebru 3000
sleep 2
B ?hit $ebru 3000
A expect ai $ebru contains brawl=0 timeout=60
A expect gvar DAS_ArenaSystem MainFight_Participant_01_Won == 0 timeout=5
A expect ai me contains brawl=0 timeout=30
