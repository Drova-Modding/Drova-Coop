# The game's own arena (Remnants camp, not the mod's coop_arena): $p books the Mog training fight - Morvin first
# ("I could give it a shot."), then Mog ("Proximus said we should train."). The arena's own flags (DAS_ArenaSystem) are
# kept per machine, so the fight is the booking player's: the other machine sees it through the creature sync.
$p tpnear $morvin 40 0
sleep 6
$p tpnear $morvin 40 0
sleep 2
$p talk $morvin
$p skip
$p expect dialogue contains "I could give it a shot." timeout=40
$p choose I could give it a shot.
$p ?bye
$p expect dialogue contains "in=0" timeout=30
$p tpnear $mog 40 0
sleep 6
$p tpnear $mog 40 0
sleep 2
$p talk $mog
$p skip
$p expect dialogue contains "Proximus said we should train." timeout=40
$p choose Proximus said we should train.
$p skip
$p expect dialogue contains "Proximus says we should fight" timeout=20
$p choose Proximus says we should fight
$p skip first
$p expect dialogue contains "in=0" timeout=60
$p expect gvar DAS_ArenaSystem TrainingFight_FaceHauer == 1 timeout=10
# The fighter's start mark; the fight begins once both fighters stand at theirs.
$p tp -1314,666
$p expect ai me contains brawl=1 timeout=90
