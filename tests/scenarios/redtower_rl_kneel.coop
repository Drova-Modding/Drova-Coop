B hit Draugr 2000
A hit Draugr 2000
B hit Draugr 2000
A expect gvar QuestVars_RedTowerStage03 KilledAllEnemies == 1 timeout=60
B expect gvar QuestVars_RedTowerStage03 DestroyConstruct == 1 timeout=30
B expect near $jero 1200 contains "1 dist" timeout=10
A expect near $jero 1200 contains "1 dist" timeout=10

# Jero after the fight, Fulk at the barrier, Darwin told, Jero at the door: each walks up to a player close by.
# unverified: Jero's floor-3 after-fight beat carries the same name as floor 2's.
A expect ai $jero contains Beat_WaitAfterAttacking timeout=60
B tpnear $jero 40 0
# Far copies are placed from the host only once the player comes near (5 s sweep).
sleep 6
B tpnear $jero 40 0
sleep 2
B walk -1 0 0.3
include redtower_talk.part
A expect gvar QuestVars_RedTowerStage03 GoToEndStageDoor == 1 timeout=60

# Fulk finds a barrier (host, no choice), Darwin is told (host), and at the door Jero's talk carries everybody up.
A expect gvar EVars_Fulk_Intent RedTower_Stage03_SawGate == 1 timeout=90
A tpnear $fulk 40 0
sleep 2
A walk -1 0 0.3
include redtower_talk.part
A tpnear $darwin 40 0
sleep 2
# unverified: Darwin's barrier answer is offered from a plain talk, as Mombert's is on the Nemeton side.
A talk $darwin
A skip
A expect dialogue contains "We've found another magical barrier" timeout=20
A choose another magical barrier
A skip
A expect dialogue contains "in=0" timeout=60
A expect gvar QuestVars_RedTowerStage03 Leader_RunToFulkAsmus == 1 timeout=10
A expect gvar EVars_Jero_Intent RedTower_Stage03_ReachedDoor == 1 timeout=120
A tpnear $jero 40 0
sleep 2
A walk -1 0 0.3
include redtower_talk.part

# ---- Floor 4: the sibling duel. ----
B expect gvar QuestVars_RedTowerStage04 StartStage == 1 timeout=30
B expect teammate <= 300 timeout=60
A expect state contains ",31" timeout=10

# The siblings' deadly NPC duel is staged by the client's dialogue, so the client's world fights it (a lease).
# On the Remnants side Molvina wins.
B tpnear $jero 40 0
# Far copies are placed from the host only once the player comes near (5 s sweep).
sleep 6
B tpnear $jero 40 0
sleep 2
B walk -1 0 0.3
include redtower_talk.part
A expect gvar QuestVars_RedTowerStage04 FightLeader_Start == 1 timeout=30
A expect gvar EVars_Molvina_Intent RedTower_Stage04_KilledJero == 1 timeout=240
A expect dead $jero contains 1 timeout=30
B expect dead $jero contains 1 timeout=30

# Molvina's speech: kneel (Molvina lives). Taken by the client: it plays in the world that fought the duel (lease kept).
B tpnear $molvina 40 0
sleep 2
B walk -1 0 0.3
sleep 8
A skip
B skip
B expect dialogue contains "I challenge you!" timeout=90
B choose (kneel down)
B skip
B expect dialogue contains "in=0" timeout=120
# A copy of the speech on the host is closed unanswered: the choice was the client's.
A ?bye

# Both worlds agree on the outcome (branches.md 2.1, 2.2) - PlayerSurrendered above all, which the host's end dialogue reads.
set fight 0
set massacre 0
set surrendered 1
set p A
include redtower_s4_flags.part
set p B
include redtower_s4_flags.part
A expect gvar EVars_Molvina_Intent RedTower_Stage04_KilledJero == 0 timeout=30
B expect gvar EVars_Molvina_Intent RedTower_Stage04_KilledJero == 0 timeout=30
A expect dead $jero contains 1 timeout=5
B expect dead $jero contains 1 timeout=5
A expect dead $molvina contains 0 timeout=5
B expect dead $molvina contains 0 timeout=5
A expect dead $henik contains 0 timeout=5
B expect dead $henik contains 0 timeout=5
A expect dead $mombert contains 0 timeout=5
B expect dead $mombert contains 0 timeout=5
A expect dead $asmus contains 0 timeout=5
B expect dead $asmus contains 0 timeout=5
A expect dead $laudine contains 0 timeout=5
B expect dead $laudine contains 0 timeout=5
A expect dead $eugen contains 0 timeout=5
B expect dead $eugen contains 0 timeout=5
A expect dead $darwin contains 0 timeout=5
B expect dead $darwin contains 0 timeout=5
A expect dead $fulk contains 0 timeout=5
B expect dead $fulk contains 0 timeout=5
A expect dead $cuna contains 0 timeout=5
B expect dead $cuna contains 0 timeout=5

# ---- Floor 5: both take the stairs; the client walks into the Remnants' end trigger, the host answers Henik first. ----
# (Step onto the stairs from right in front of them: the floor-4 door stops a longer walk.)
B tp 30895,31255
sleep 1
B walk 0 1 0.5
B expect state contains ",343" timeout=15
A tp 30895,31255
sleep 1
A walk 0 1 0.5
A expect state contains ",343" timeout=15
A expect near $henik 1200 contains "1 dist" timeout=30
B expect near $henik 1200 contains "1 dist" timeout=30
# unverified: Molvina re-offers her speech up here to whoever stands by, as Jero does on the Nemeton side.
A skip
B skip
A choose ?(kneel down)
B choose ?(kneel down)
A skip
B skip
A expect dialogue contains "in=0" timeout=60
B expect dialogue contains "in=0" timeout=60
B tp 31242,34470
sleep 1
B walk 0 1 1
A expect gvar QuestVars_RedTowerStage05 StartEndDialogue == 1 timeout=15
set p A
include redtower_end_rl_kneel.part
set p B
include redtower_end_rl_kneel.part
A expect gvar QuestVars_RedTowerStage05 FinishedEndDialog == 1 timeout=10
A expect gvar QuestVars_RedTowerStage05 Molvina_IsLiving == 1 timeout=10
B expect gvar QuestVars_RedTowerStage05 Molvina_IsLiving == 1 timeout=10
A expect gvar QuestVars_RedTowerStage05 Jero_IsLiving == 0 timeout=10
B expect gvar QuestVars_RedTowerStage05 Jero_IsLiving == 0 timeout=10
# Stops before the boar's vessel (D): the outro is irreversible.
