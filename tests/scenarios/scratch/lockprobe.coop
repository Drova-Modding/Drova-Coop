# Probe: a won lockpick minigame, alone and in a session. Hero 5 slot 0.
launch A
launch B
A wait ready=1 timeout=240
B wait ready=1 timeout=240
A wait saves=separate timeout=1
B wait saves=separate timeout=1
A load 5 0
B load 5 0
A wait world=1 timeout=240
B wait world=1 timeout=240
A give misc_lockpick_simple 5
B give misc_lockpick_simple 5
A talent learn Talent_Lockpicking
B talent learn Talent_Lockpicking
sleep 2
A minigames on
B minigames on
A tp -1272,-4640
sleep 3
A use Interact_Port 300
A expect minigame contains open timeout=3
A minigame win
sleep 1
A minigame
