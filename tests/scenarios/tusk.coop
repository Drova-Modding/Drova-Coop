# The Great Tusk fight, Nemeton side, by two players, and the forest dying afterwards in both worlds.
# Needs hero 0 slot 61 in every profile (fixture_goddess.scn). A solo run of these steps passes.
# Waves, the Tusk beaten to 30 % (it never dies), more waves, the capture. Mombert dying ends the game.

default hero 0
default slotA 61
default slotB 61
include session.coop

# Both down at once is a lost run, and the waves down players now and then: kept standing.
A run invincibility
B run invincibility

set mombert 8fe6b401-4600-4662-9702-b3cc379f269b

# The forest is untouched in both worlds.
A expect gvar WorldVars Leuchtwald_Destroyed == 0 timeout=5
A expect objects Veil_Big_00 >= 1 timeout=20
B expect objects Veil_Big_00 >= 1 timeout=20
B expect near $mombert 600 contains "1 dist" timeout=30
# At the circle his routine gives him a torch, in the client's copy too.
B expect ai $mombert contains torch=1 timeout=30

# ---- The client talks to Mombert: the party takes its places and the ritual begins. ----
B tpnear $mombert 40 0
sleep 6
B tpnear $mombert 40 0
sleep 2
B talk $mombert
B skip
B expect dialogue contains "I'm ready. For Nemeton!" timeout=180
B choose I'm ready. For Nemeton!
B skip
B expect dialogue contains "in=0" timeout=120
A expect gvar GVars_Fight_GreatTuskFight StartRitual_Start == 1 timeout=10
A skip first

# ---- The ritual waves, fought by both. ----
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A expect gvar GVars_Fight_GreatTuskFight StartRitual_Finished == 1 timeout=90
B expect gvar GVars_Fight_GreatTuskFight StartRitual_Finished == 1 timeout=10

# Mombert's talk (whoever he walks up to) starts the manifestation; its waves, again by both.
include tusk_talk.part
A expect gvar GVars_Fight_GreatTuskFight Manifestation_Start == 1 timeout=60
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit LightBear 1500
B ?hit LightBear 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit LightBear 1500
B ?hit LightBear 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit LightBear 1500
B ?hit LightBear 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit LightBear 1500
B ?hit LightBear 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit LightBear 1500
B ?hit LightBear 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit LightBear 1500
B ?hit LightBear 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit LightBear 1500
B ?hit LightBear 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit LightBear 1500
B ?hit LightBear 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit LightBear 1500
B ?hit LightBear 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar_Luminous 1500
B ?hit Boar_Luminous 1500
sleep 2
A ?hit LightBear 1500
B ?hit LightBear 1500
sleep 2
A expect gvar GVars_Fight_GreatTuskFight Manifestation_Finished == 1 timeout=90
B expect gvar GVars_Fight_GreatTuskFight Manifestation_Finished == 1 timeout=10

# ---- The Tusk arrives and is beaten down - half the blows from each player. It ends at 30 % in both worlds. ----
include tusk_talk.part
A expect actors 1500 contains GreatTusk timeout=120
B expect actors 1500 contains GreatTusk timeout=30
A ?hit GreatTusk 1500
B ?hit GreatTusk 1500
A ?hit GreatTusk 1500
B ?hit GreatTusk 1500
A ?hit GreatTusk 1500
B ?hit GreatTusk 1500
A ?hit GreatTusk 1500
B ?hit GreatTusk 1500
A ?hit GreatTusk 1500
B ?hit GreatTusk 1500
A ?hit GreatTusk 1500
B ?hit GreatTusk 1500
A ?hit GreatTusk 1500
B ?hit GreatTusk 1500
A ?hit GreatTusk 1500
B ?hit GreatTusk 1500
A expect gvar GVars_Fight_GreatTuskFight MainFight_Finished == 1 timeout=30
B expect gvar GVars_Fight_GreatTuskFight MainFight_Finished == 1 timeout=10
A expect health $mombert cur >= 1 timeout=1

# ---- The boars and piglets, then the capture. Mombert holds the Tusk with an endless cast - on the client too. ----
include tusk_talk.part
B expect ai $mombert contains AA_Flow_InfiniteSpell timeout=30
B expect ai $mombert contains torch=0 timeout=10
A ?hit Boar 1500
B ?hit Boar 1500
sleep 2
A ?hit NPC_Piglet 1500
B ?hit NPC_Piglet 1500
sleep 2
A ?hit Shadow 1500
B ?hit Shadow 1500
sleep 2
A ?hit Boar 1500
B ?hit Boar 1500
sleep 2
A ?hit NPC_Piglet 1500
B ?hit NPC_Piglet 1500
sleep 2
