A expect gvar $quest Mottek_RdyRunningToBandits == 1 timeout=90
A expect ai $m contains "pos=" timeout=1
B expect steered $m == 1 timeout=5

# ---- He waits to be told. The client tells him. ----
B tpnear $m 50 0
B expect talk $m contains talking timeout=20
B skip
B expect dialogue contains "choices=0:Let's go to the Pit" timeout=20
B choose 0
B skip first
B expect dialogue contains "in=0" timeout=60
A expect gvar $quest Mottek_StartedRunningToBandits == 1 timeout=10

# ---- The bandits' toll post. Adalgis stops the client, who refuses to pay. ----
B tpnear $m 45 0
A tpnear $m -120 20
B walk -1 0 1
sleep 3
