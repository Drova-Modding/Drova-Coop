<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>annotations</Nullable>
        <LangVersion>12</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>DrovaCoopMod</RootNamespace>
        <AssemblyName>DrovaCoopMod</AssemblyName>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!--
        The API is the only coop dependency: nothing here names LiteNetLib, and nothing here needs to know
        whether the session runs direct or through a relay. Whether the transport exists at all is a
        property of the installed API build, checked at runtime through NetworkAccess.IsSupported.
    -->
    <!--
        The wire contract lives in its own assembly with no game references. That makes the
        no-game-types-on-the-wire rule structural rather than remembered, and it is what lets CI build and
        test the serialization on a runner that cannot have the game's Il2Cpp assemblies.
    -->
    <ItemGroup>
        <ProjectReference Include="..\DrovaCoopMod.Protocol\DrovaCoopMod.Protocol.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Drova_Modding_API">
            <HintPath>$(ApiAssembly)</HintPath>
        </Reference>
        <Reference Include="MelonLoader">
            <HintPath>$(GameDir)\MelonLoader\net6\MelonLoader.dll</HintPath>
        </Reference>
        <Reference Include="Unity.InputSystem">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.InputSystem.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        <Reference Include="Il2Cppmscorlib">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppInterop.Runtime">
            <HintPath>$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!--
        MelonInfo needs its version as a compile-time constant, so the version in Directory.Build.props is
        written out as one. A const field reference satisfies the attribute; a property or a runtime lookup
        would not, which is why this generates a file rather than reading the assembly version back.

        No Inputs/Outputs on the target on purpose: skipping it when the file is up to date would also skip
        adding the Compile item, and the build would then fail on a missing BuildInfo. WriteOnlyWhenDifferent
        keeps it from touching the file and forcing a rebuild every time.
    -->
    <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile;CoreCompile">
        <ItemGroup>
            <BuildInfoLine Include="// &lt;auto-generated /&gt;" />
            <BuildInfoLine Include="// Generated from &lt;Version&gt; in Directory.Build.props. Do not edit." />
            <BuildInfoLine Include="namespace DrovaCoopMod" />
            <BuildInfoLine Include="{" />
            <BuildInfoLine Include="    internal static class BuildInfo" />
            <BuildInfoLine Include="    {" />
            <BuildInfoLine Include="        internal const string Version = &quot;$(Version)&quot;%3B" />
            <BuildInfoLine Include="    }" />
            <BuildInfoLine Include="}" />
        </ItemGroup>

        <WriteLinesToFile
            File="$(IntermediateOutputPath)BuildInfo.g.cs"
            Lines="@(BuildInfoLine)"
            Overwrite="true"
            WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
        </ItemGroup>
    </Target>

    <!--
        The protocol assembly goes to UserLibs, not Mods: MelonLoader treats everything in Mods as a melon
        and complains about anything without a MelonInfo attribute, while UserLibs is where plain libraries
        belong and are resolved from.
    -->
    <Target Name="InstallToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\Mods')">
        <MakeDir Directories="$(GameDir)\UserLibs" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
        <Copy SourceFiles="$(TargetDir)DrovaCoopMod.Protocol.dll" DestinationFolder="$(GameDir)\UserLibs" />
    </Target>

</Project>
