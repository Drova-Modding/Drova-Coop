# The Red Tower, Remnants side (redtower.coop with Jero as leader), ending in the kneel: the client kneels to Molvina
# after she kills Jero in the sibling duel, and Molvina lives.
# Needs hero 0 slot 65 in every profile (fixture_redtower_rl.scn). Plan: branches.md 3.2 and 4.3 (RL-K).
# Key check: the host's end dialogue takes Molvina's branch only because PlayerSurrendered crossed from the client.
# Irreversible past the duel (a leader's death, chapter 5): never save in this run.

default hero 0
default slotA 65
default slotB 65
include session.coop

set jero c0f378bc-87fe-4b00-8969-c7ff5550a7ec
set molvina 19d2fee9-aaca-453a-a56d-f8f841b0f719
# The sibling duel runs in the client's world; the host's copies mirror it (LeaseMirror).
track $jero
track $molvina
set henik 1d68e5c7-bf2a-4ca5-9366-ca3b27404f08
set mombert 8fe6b401-4600-4662-9702-b3cc379f269b
set asmus 8678e993-82fb-4d0e-8e49-dc8d56d7c9ca
set laudine 6f995a7d-c08e-4bf5-bdac-a37ff5d0da26
set eugen 6c5b73ff-9cc7-43ee-99d7-f69ea4208785
set darwin a96970a5-6ef4-447e-b78a-dc2f39465d16
set fulk 650cbc12-f250-4782-b76f-bf9c7a9059b7
set cuna 54527994-acd2-4392-b490-90f3ed5b93d8

# ---- The client hands the charged crystals to Jero at the tower gate (his intent TalkAboutLoadedCrystals). ----
B tpnear $jero 80 0
B expect near $jero 400 contains loaded timeout=15
B tpnear $jero 40 0
sleep 2
B walk -1 0 0.3
B skip
B expect dialogue contains "Yes, here. (hand over)" timeout=30
B choose Yes, here.
B skip
B expect popup contains "_" timeout=20
B popup yes
B skip
B expect dialogue contains "I'm ready." timeout=30
B choose I'm ready.
A expect gvar QuestVars_LoadCrystals HTT_Leader_AboutLoadingCrystals == 1 timeout=10
A expect gvar QuestVars_LoadCrystals QuestState == 3 timeout=10
B expect items Misc_Energycrystal_CityDungeon_Charged == 0 timeout=10

# ---- The ritual, by the client: the party is ported into the tower - the host must end up inside too. ----
# unverified: Jero's tower-entry talk (DT_Quest_StartEnterRedTowerRuinenlager_NPC_Jero) follows the hand-over in the same conversation.
B skip
B expect dialogue contains "For freedom! (salute)" timeout=90
B choose For freedom!
B skip
B expect dialogue contains "in=0" timeout=180
A expect gvar QuestVars_EnteringRedTower PlayerReady == 1 timeout=10
A expect gvar QuestVars_RedTowerStage01 GoIntoRedTower == 1 timeout=10
A expect gvar QuestVars_RedTowerStage01 EnterRedTower == 1 timeout=10
A expect gvar QuestVars_RedTowerStage01 EnterRoom01 == 1 timeout=10
A expect gvar QuestVars_RedTowerStage01 EndIntroDialog == 1 timeout=10
A expect gvar WorldVars CurrentChapter == 5 timeout=10
B expect state contains "pos=31" timeout=30
A expect state contains "pos=31" timeout=60
# unverified: the RL entry brings the party (Jero) into the tower with the players.
A expect near $jero 2000 contains "1 dist" timeout=60
B expect near $jero 2000 contains "1 dist" timeout=60

# ---- Floor 1: the Draugr at the rune circle, if the Remnants' entry wakes them. ----
# unverified: whether the RL entry wakes the floor-1 Draugr at all (the Nemeton entry cutscene sets the ML trigger):
# every blow is optional, DraugrAllDead not required.
A ?hit Draugr_Sword_Shield 900
B ?hit Draugr_Sword_Shield 900
A ?hit Draugr_Sword_Shield 900
B ?hit Draugr_Sword_Shield 900
A ?hit Draugr_Sword_Shield 900
B ?hit Draugr_Sword_Shield 900
sleep 3
A ?hit Draugr_Sword_Shield 900
B ?hit Draugr_Sword_Shield 900
sleep 3
A ?hit Draugr_Sword_Shield 900
B ?hit Draugr_Sword_Shield 900

# Jero's routine arms his intent at the rune circle; he walks up to a player close by (no choices).
# unverified: the intent's list and name, EVars_Jero_Intent RedTower_Stage01_ReachedCenterRoom.
A expect gvar EVars_Jero_Intent RedTower_Stage01_ReachedCenterRoom == 1 timeout=120
B tpnear $jero 40 0
# Far copies are placed from the host only once the player comes near (5 s sweep).
sleep 6
B tpnear $jero 40 0
sleep 2
B walk -1 0 0.3
include redtower_talk.part
A expect gvar QuestVars_RedTowerStage01 EndDialogRuneCircle == 1 timeout=30
B expect near $jero 1200 contains "1 dist" timeout=30

# ---- Floor 1: the three sealed rooms and the relics, split between the players (same objects as ML). ----
# Room 2's switch is hidden until perceived (the host finds it). Rooms 1 and 3 are minigames the agent cannot play
# (Lyra melody, rune drawing): their result flags stand in, set by the client.
A tp 30976,18760
sleep 2
A stance Normal
A perceive Perception_WallButton 200
sleep 1
A expect use Interact_Lever 100 contains "used" timeout=10
B expect gvar QuestVars_RedTowerStage01 OpenDoor_Room_02 == 1 timeout=20
B setgvar QuestVars_RedTowerStage01 OpenDoor_Room_01 1
B setgvar QuestVars_RedTowerStage01 OpenDoor_Room_03 1
A expect gvar QuestVars_RedTowerStage01 OpenDoor_Room_03 == 1 timeout=10

# A relic is a dialogue grant, so the teammate gets one too: either player can carry any to the plinths.
# Weapons sheathed first: a pedestal offers its dialogue only in the normal stance.
B tp 31294,18660
sleep 2
B stance Normal
B perceive PerceptableDialog 200
B expect use Interact_Dialogue 120 contains "used" timeout=10
B skip
B expect dialogue contains "choices=0:(take antlers)" timeout=15
B choose take antlers
B skip
B expect dialogue contains "in=0" timeout=30
A expect items misc_riddle_deer >= 1 timeout=10
A tp 31135,18690
sleep 2
A stance Normal
A perceive PerceptableDialog 150
A expect use Interact_Dialogue 120 contains "used" timeout=10
A skip
A expect dialogue contains "choices=0:(take the paw)" timeout=15
A choose take the paw
A skip
A expect dialogue contains "in=0" timeout=30
A tp 30976,18660
sleep 2
A stance Normal
A perceive PerceptableDialog 150
A expect use Interact_Dialogue 120 contains "used" timeout=10
A skip
A expect dialogue contains "choices=0:(take feather)" timeout=15
A choose take feather
A skip
A expect dialogue contains "in=0" timeout=30
B expect items misc_riddle_eagle >= 1 timeout=10
B expect gvar QuestVars_RedTowerStage01 PickedUpFirstRelic == 1 timeout=10

# The plinths: the deer by the client, the eagle and the fox by the host.
B tp 30790,18433
sleep 2
B place misc_riddle_deer 100
A expect gvar QuestVars_RedTowerStage01 ActivateThirstRelic == 1 timeout=10
A tp 30830,18335
sleep 2
A place misc_riddle_eagle 100
A tp 30790,18534
sleep 2
A place misc_riddle_fox 100
B expect gvar QuestVars_RedTowerStage01 ActivateFirstRelic == 1 timeout=10
B expect gvar QuestVars_RedTowerStage01 ActivateSecondRelic == 1 timeout=10

# Jero's end of the floor (AddAllRelicsToSockel, all answers equal): he walks up to a player close by.
A tpnear $jero 40 0
sleep 2
A walk -1 0 0.3
include redtower_talk.part
B expect gvar QuestVars_RedTowerStage01 EndStage01 == 1 timeout=10
B expect gvar QuestVars_RedTowerStage01 OpenDoor == 1 timeout=10
B expect gvar QuestVars_RedTowerStage02 StartingAttacking == 1 timeout=10

# ---- Floor 2: Jero's talk ported the talker up; the teammate is brought along. Two waves, fought by both. ----
# unverified: the RL floor-1 end talk ports the talker up as Molvina's does.
A expect state contains "pos=31" timeout=30
include redtower_talk.part
B expect teammate <= 300 timeout=60
A expect gvar QuestVars_RedTowerStage02 StartingAttacking == 1 timeout=5
A hit Draugr 1500
B hit Draugr 1500
B hit Golem 1500
A hit Draugr 1500
B hit Draugr 1500
B hit Golem 1500
A hit Draugr 1500
B hit Draugr 1500
