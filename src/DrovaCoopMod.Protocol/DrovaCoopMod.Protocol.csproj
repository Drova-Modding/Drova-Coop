<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The wire contract: plain messages with no game types, so CI can build and test it without the game.
        The API is the only reference. Never add MelonLoader, UnityEngine or Il2Cpp* here.
    -->

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>annotations</Nullable>
        <LangVersion>12</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>DrovaCoopMod</RootNamespace>
        <AssemblyName>DrovaCoopMod.Protocol</AssemblyName>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Drova_Modding_API">
            <HintPath>$(ApiAssembly)</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
