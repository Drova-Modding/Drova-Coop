<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>annotations</Nullable>
        <LangVersion>12</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>DrovaCoopMod</RootNamespace>
        <AssemblyName>DrovaCoopMod</AssemblyName>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!--
        The API is the only coop dependency: nothing here names LiteNetLib, and nothing here needs to know
        whether the session runs direct or through a relay. Whether the transport exists at all is a
        property of the installed API build, checked at runtime through NetworkAccess.IsSupported.
    -->
    <!--
        The wire contract lives in its own assembly with no game references. That makes the
        no-game-types-on-the-wire rule structural rather than remembered, and it is what lets CI build and
        test the serialization on a runner that cannot have the game's Il2Cpp assemblies.
    -->
    <ItemGroup>
        <ProjectReference Include="..\DrovaCoopMod.Protocol\DrovaCoopMod.Protocol.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Drova_Modding_API">
            <HintPath>$(ApiAssembly)</HintPath>
        </Reference>
        <Reference Include="MelonLoader">
            <HintPath>$(GameDir)\MelonLoader\net6\MelonLoader.dll</HintPath>
        </Reference>
        <Reference Include="Unity.InputSystem">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.InputSystem.dll</HintPath>
        </Reference>
        <!--
            Loading a shared cutscene's data on the machine that never streamed it. ResourceManager
            carries the handle type the load returns.
        -->
        <Reference Include="Unity.Addressables">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.Addressables.dll</HintPath>
        </Reference>
        <Reference Include="Unity.ResourceManager">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.ResourceManager.dll</HintPath>
        </Reference>
        <!-- CS_CutsceneData's base type. Odin serialization, which the game builds its data assets on. -->
        <Reference Include="Il2CppSirenix.Serialization">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSirenix.Serialization.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        <!--
            Name tags are drawn with IMGUI. The game's Unity modules are stripped, so this being present
            is not a given - it was checked before anything was written against it.
        -->
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.IMGUIModule.dll</HintPath>
        </Reference>
        <!--
            Canvas, which is what a puppet's inherited interface is switched off at. Not in CoreModule
            despite the namespace saying UnityEngine, and stripped builds do not always ship it.
        -->
        <Reference Include="UnityEngine.UIModule">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.UIModule.dll</HintPath>
        </Reference>
        <!-- TextAnchor and FontStyle, which a GUIStyle is configured with, live here rather than in IMGUI. -->
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.TextRenderingModule.dll</HintPath>
        </Reference>
        <!-- Collider2D and Rigidbody2D, which a remote body has to be taken out of. -->
        <Reference Include="UnityEngine.Physics2DModule">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.Physics2DModule.dll</HintPath>
        </Reference>
        <!--
            HashSet lives here rather than in Il2Cppmscorlib, which is where the managed original is - the
            interop assemblies are split along the game's own runtime, not along the framework's.
        -->
        <Reference Include="Il2CppSystem.Core">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSystem.Core.dll</HintPath>
        </Reference>
        <Reference Include="Il2Cppmscorlib">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
        </Reference>
        <!--
            ConditionTask, the base of the behavior-tree node that decides whether the player is close
            enough to be worth reacting to. Drova's AI graphs are NodeCanvas, and NodeCanvas's task base
            classes live in the ParadoxNotion framework rather than in the game - so asking that node to
            answer again for a second player needs the assembly the node inherits from, not the one the
            node is in.
        -->
        <Reference Include="Il2CppParadoxNotion">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppParadoxNotion.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppInterop.Runtime">
            <HintPath>$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!--
        The game's own assemblies. Actor's base chain and PlayableSceneSetup's both leave Il2CppDrova:
        AManagedBehaviour comes from Gilzoide's update manager and ASceneSetup from Just2D. Without all
        three, every member Actor inherits from MonoBehaviour - transform, gameObject, name - fails to
        resolve, which reads as dozens of unrelated errors.
    -->
    <ItemGroup>
        <Reference Include="Il2CppDrova">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppDrova.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppFileHandling">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppFileHandling.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppGilzoide.UpdateManager">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppGilzoide.UpdateManager.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppJust2D">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppJust2D.dll</HintPath>
        </Reference>
        <!--
            OW_ReferencePoint and OW_Root: the chunk streaming system. A remote body needs a reference point
            of its own or the world only exists around whoever is local.
        -->
        <Reference Include="Il2CppOpenWorld.Runtime">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppOpenWorld.Runtime.dll</HintPath>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(GameDir)\MelonLoader\net6\0Harmony.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!--
        MelonInfo needs its version as a compile-time constant, so the version in Directory.Build.props is
        written out as one. A const field reference satisfies the attribute; a property or a runtime lookup
        would not, which is why this generates a file rather than reading the assembly version back.

        No Inputs/Outputs on the target on purpose: skipping it when the file is up to date would also skip
        adding the Compile item, and the build would then fail on a missing BuildInfo. WriteOnlyWhenDifferent
        keeps it from touching the file and forcing a rebuild every time.
    -->
    <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile;CoreCompile">
        <ItemGroup>
            <BuildInfoLine Include="// &lt;auto-generated /&gt;" />
            <BuildInfoLine Include="// Generated from &lt;Version&gt; in Directory.Build.props. Do not edit." />
            <BuildInfoLine Include="namespace DrovaCoopMod" />
            <BuildInfoLine Include="{" />
            <BuildInfoLine Include="    internal static class BuildInfo" />
            <BuildInfoLine Include="    {" />
            <BuildInfoLine Include="        internal const string Version = &quot;$(Version)&quot;%3B" />
            <BuildInfoLine Include="    }" />
            <BuildInfoLine Include="}" />
        </ItemGroup>

        <WriteLinesToFile
            File="$(IntermediateOutputPath)BuildInfo.g.cs"
            Lines="@(BuildInfoLine)"
            Overwrite="true"
            WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
        </ItemGroup>
    </Target>

    <!--
        The protocol assembly goes to UserLibs, not Mods: MelonLoader treats everything in Mods as a melon
        and complains about anything without a MelonInfo attribute, while UserLibs is where plain libraries
        belong and are resolved from.
    -->
    <Target Name="InstallToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\Mods')">
        <MakeDir Directories="$(GameDir)\UserLibs" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
        <Copy SourceFiles="$(TargetDir)DrovaCoopMod.Protocol.dll" DestinationFolder="$(GameDir)\UserLibs" />
    </Target>

</Project>
