<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>annotations</Nullable>
        <LangVersion>12</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>DrovaCoopMod</RootNamespace>
        <AssemblyName>DrovaCoopMod</AssemblyName>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!--
        The API is the only coop dependency: nothing here names LiteNetLib, and nothing here needs to know
        whether the session runs direct or through a relay. Whether the transport exists at all is a
        property of the installed API build, checked at runtime through NetworkAccess.IsSupported.
    -->
    <!--
        The wire contract lives in its own assembly with no game references. That is the roadmap's
        no-game-types-on-the-wire rule made structural rather than remembered, and it is what lets CI build
        and test the serialization on a runner that cannot have the game's Il2Cpp assemblies.
    -->
    <ItemGroup>
        <ProjectReference Include="..\DrovaCoopMod.Protocol\DrovaCoopMod.Protocol.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Drova_Modding_API">
            <HintPath>$(ApiAssembly)</HintPath>
        </Reference>
        <Reference Include="MelonLoader">
            <HintPath>$(GameDir)\MelonLoader\net6\MelonLoader.dll</HintPath>
        </Reference>
        <Reference Include="Unity.InputSystem">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.InputSystem.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        <Reference Include="Il2Cppmscorlib">
            <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppInterop.Runtime">
            <HintPath>$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!--
        The protocol assembly goes to UserLibs, not Mods: MelonLoader treats everything in Mods as a melon
        and complains about anything without a MelonInfo attribute, while UserLibs is where plain libraries
        belong and are resolved from.
    -->
    <Target Name="InstallToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\Mods')">
        <MakeDir Directories="$(GameDir)\UserLibs" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
        <Copy SourceFiles="$(TargetDir)DrovaCoopMod.Protocol.dll" DestinationFolder="$(GameDir)\UserLibs" />
    </Target>

</Project>
