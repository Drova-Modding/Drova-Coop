# Blows between two clients, which the host only relays: whether they may land is a question about those two, not
# about the host. Friendly fire off; the host marks an arena and walks out of it; B and C stand inside and fight -
# a sword blow and a poison cry must reach C. Once the arena is down, neither may.

include session3_net.coop

A give item_potion_flow_1 4
B give cons_flow_venomCry 3
C give item_potion_health_0 10
B expect equip weapon_sword_longsword contains "equipped" timeout=6
A ff off
C expect state contains "ff=off" timeout=10

A tp -2040,-5262
A run coop_arena 300
A tp -2040,-4600
B tp -2040,-5262
C tp -2000,-5262
sleep 3
B look DrovaCoop.Remote.2
B stance combat
sleep 2
C expect health me == 40/40 timeout=2
# Aimed at where B's copy of C stands a moment after the teleports, and swung a second time should the first
# land before that copy caught up - a miss would say nothing about the relay.
B look DrovaCoop.Remote.2
B press primaryattack
sleep 2
B tp -2040,-5262
B look DrovaCoop.Remote.2
B press primaryattack
sleep 2.5
C expect counter dmgapplied >= 1 timeout=5
# A sword blow (44 raw) downs the unarmored C outright, which in the arena ends the round at once and heals everyone:
# the host calling it is what shows the blow landed, not C's health.
A expect run coop_status contains "1 called" timeout=10

# The same for an effect: a poison cry from B lands once on C.
sleep 6
C useitem item_potion_health_0
sleep 5
B tp -2040,-5262
C tp -2000,-5262
sleep 2
B look DrovaCoop.Remote.2
B expect useitem cons_flow_venomCry 0.4 contains "used" timeout=6
C expect effects me == StatusEffect_Poison timeout=5

# The arena taken down: the same blow no longer lands.
A run coop_arena off
sleep 12
C useitem item_potion_health_0
sleep 5
C useitem item_potion_health_0
sleep 5
C expect health me == 40/40 timeout=5
B tp -2040,-5262
C tp -2000,-5262
sleep 2
B look DrovaCoop.Remote.2
B press primaryattack
sleep 2.5
C expect health me == 40/40 timeout=3
